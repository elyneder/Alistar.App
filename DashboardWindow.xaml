<Window x:Class="Alistar.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Alistar | Conscritos"
        Height="720"
        Width="1220"
        WindowState="Maximized">
    <Grid Background="#F6F8F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White"
                Margin="24,24,24,18"
                Padding="24"
                CornerRadius="24"
                BorderBrush="#DFE7E2"
                BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="30"
                               FontWeight="Bold"
                               Foreground="#123322"
                               Text="Sistema Alistar" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="15"
                               Foreground="#688077"
                               Text="Cadastre conscritos e consulte a lista completa dos candidatos." />
                </StackPanel>
                <Button DockPanel.Dock="Right"
            Width="100"
            Margin="0,0,0,0"
            HorizontalAlignment="Right"
            Background="#196743"
            Style="{StaticResource PrimaryButtonStyle}"
            Click="LogoutButton_Click"
            Content="Sair" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#0F291D"
                    CornerRadius="24"
                    Padding="24">
                <StackPanel>
                    <Button x:Name="ShowRegisterViewButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ShowRegisterViewButton_Click"
                            Content="Cadastrar conscrito" />

                    <Button x:Name="ShowHomeViewButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ShowHomeViewButton_Click"
                            Content="Tela inicial" />

                    <Button x:Name="ShowListViewButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ShowListViewButton_Click"
                            Content="Consultar lista" />

                    <Border Margin="0,24,0,0"
                            Padding="18"
                            CornerRadius="18"
                            Background="#163626">
                        <StackPanel>
                            <TextBlock Foreground="White"
                                       FontWeight="SemiBold"
                                       Text="Resumo" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="#C9D7D0"
                                       Text="Total de candidatos cadastrados" />
                            <TextBlock x:Name="ConscriptsCountTextBlock"
                                       Margin="0,8,0,0"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Border x:Name="HomeViewBorder"
                        Background="White"
                        CornerRadius="24"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        Padding="28">
                    <StackPanel>
                        <TextBlock FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#123322"
                                   Text="Tela inicial do sistema Alistar" />

                        <TextBlock Margin="0,10,0,24"
                                   FontSize="16"
                                   Foreground="#63756E"
                                   TextWrapping="Wrap"
                                   Text="A partir desta tela voce pode cadastrar um novo conscrito ou consultar todos os candidatos ja registrados no sistema." />

                        <UniformGrid Columns="3" Margin="0,0,0,24">
                            <Border Margin="0,0,12,0"
                                    Padding="18"
                                    Background="#F3F7F5"
                                    CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Foreground="#6A7A73" Text="Candidatos cadastrados" />
                                    <TextBlock x:Name="HomeConscriptsCountTextBlock"
                                               Margin="0,6,0,0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#123322"
                                               Text="0" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,12,0"
                                    Padding="18"
                                    Background="#F3F7F5"
                                    CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Foreground="#6A7A73" Text="Fluxo principal" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#123322"
                                               Text="Cadastro" />
                                </StackPanel>
                            </Border>
                            <Border Padding="18"
                                    Background="#F3F7F5"
                                    CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Foreground="#6A7A73" Text="Consulta" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#123322"
                                               Text="Lista completa" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="#0F291D"
                                CornerRadius="22"
                                Padding="24"
                                Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Text="Bem-vindo ao painel inicial" />
                                <TextBlock Margin="0,10,0,0"
                                           FontSize="15"
                                           Foreground="#D1DDD6"
                                           TextWrapping="Wrap"
                                           Text="Use os atalhos ao lado para abrir o formulario de cadastro de conscritos ou a lista de candidatos armazenados." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="RegisterViewBorder"
                        Visibility="Collapsed"
                        Background="White"
                        CornerRadius="24"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        Padding="28">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760">
                            <TextBlock FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#123322"
                                       Text="Cadastrar conscrito" />

                            <TextBlock Margin="0,10,0,24"
                                       FontSize="16"
                                       Foreground="#63756E"
                                       TextWrapping="Wrap"
                                       Text="Preencha a ficha inicial do candidato. Depois do cadastro, ele sera armazenado na lista do sistema." />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Nome" />
                                    <TextBox x:Name="NameTextBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Nome da mae" />
                                    <TextBox x:Name="MotherNameTextBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Nome do pai" />
                                    <TextBox x:Name="FatherNameTextBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Data de nascimento" />
                                    <TextBox x:Name="BirthDateTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             ToolTip="Exemplo: 15/04/2006" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Endereco" />
                                    <TextBox x:Name="AddressTextBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Cidade" />
                                    <TextBox x:Name="CityTextBox" Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Escolaridade" />
                                    <ComboBox x:Name="EducationComboBox"
                                              Margin="0,0,0,14"
                                              Padding="12,8"
                                              BorderBrush="#D5DDD8"
                                              BorderThickness="1"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Ensino fundamental" />
                                        <ComboBoxItem Content="Ensino medio" />
                                        <ComboBoxItem Content="Ensino tecnico" />
                                        <ComboBoxItem Content="Ensino superior" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="RegisterFeedbackTextBlock"
                                       Margin="0,6,0,8"
                                       Foreground="#C43D3D"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal">
                                <Button Width="190"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SaveConscriptButton_Click"
                                        Content="Salvar ficha" />
                                <Button Width="160"
                                        Margin="14,8,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ClearFormButton_Click"
                                        Content="Limpar" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="ListViewBorder"
                        Visibility="Collapsed"
                        Background="White"
                        CornerRadius="24"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#123322"
                                       Text="Lista de candidatos" />
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="16"
                                       Foreground="#63756E"
                                       Text="Aqui ficam todos os conscritos cadastrados no sistema." />
                        </StackPanel>

                        <DataGrid x:Name="ConscriptsDataGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  RowBackground="#FFFFFF"
                                  AlternatingRowBackground="#F6F8F7">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#145C3B" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="10" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Width="1.5*" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Mae" Width="1.5*" Binding="{Binding MotherName}" />
                                <DataGridTextColumn Header="Pai" Width="1.5*" Binding="{Binding FatherName}" />
                                <DataGridTextColumn Header="Nascimento" Width="1*" Binding="{Binding BirthDate}" />
                                <DataGridTextColumn Header="Cidade" Width="1*" Binding="{Binding City}" />
                                <DataGridTextColumn Header="Escolaridade" Width="1.2*" Binding="{Binding Education}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
