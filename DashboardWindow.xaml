<Window x:Class="Alistar.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Painel de Controle" 
        Height="760" Width="1280"
        WindowState="Maximized" 
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0B0A8"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#196743"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepCardStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="20">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F7F5"/>
                    <Setter Property="BorderBrush" Value="#196743"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#196743"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#145235"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E8ECEA"/>
            <Setter Property="Foreground" Value="#123322"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D5DDD8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#0B1E14" CornerRadius="0,24,24,0">
            <Grid Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,40" HorizontalAlignment="Center">
                    <Border Width="110" Height="110" CornerRadius="20" BorderBrush="#2A6644" BorderThickness="2" Margin="0,0,0,16">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/a1.jpeg" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="ALISTAR" FontSize="26" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Sistema de Conscritos" FontSize="12" Foreground="#688077" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="BtnHome" Content="🏠  Tela Inicial" Click="ShowHomeViewButton_Click" Style="{StaticResource SidebarButtonStyle}"/>
                    <Button x:Name="BtnList" Content="📋  Consultar Lista" Click="ShowListViewButton_Click" Style="{StaticResource SidebarButtonStyle}"/>

                    <Border Margin="0,30,0,0" Padding="16" CornerRadius="12" Background="#163626">
                        <StackPanel>
                            <TextBlock Text="Total Cadastrados" Foreground="#8BA698" FontSize="12"/>
                            <TextBlock x:Name="ConscriptsCountTextBlock" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Row="2" Content="Sair do Sistema" Click="LogoutButton_Click" Background="Transparent" Foreground="#E74C3C" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Painel de Controle" FontSize="32" FontWeight="Bold" Foreground="#123322"/>
                <TextBlock Text="Gerencie as etapas de alistamento e consulte a base de dados." FontSize="15" Foreground="#688077" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">

                <ScrollViewer x:Name="HomeViewBorder" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Fluxo de Etapas" FontSize="20" FontWeight="SemiBold" Foreground="#123322" Margin="0,0,0,16"/>

                        <UniformGrid Columns="3">
                            <Button Click="Step1_Click" Style="{StaticResource StepCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="01" FontSize="32" FontWeight="Black" Foreground="#123322"/>
                                    <TextBlock Text="Primeira Etapa" FontWeight="Bold" FontSize="18" Foreground="#123322" Margin="0,4,0,0"/>
                                    <TextBlock Text="Cadastrar conscrito" FontSize="13" Foreground="#688077"/>
                                </StackPanel>
                            </Button>

                            <Button Click="FutureStep_Click" Style="{StaticResource StepCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="02" FontSize="32" FontWeight="Black" Foreground="#123322"/>
                                    <TextBlock Text="Segunda Etapa" FontWeight="Bold" FontSize="18" Foreground="#123322" Margin="0,4,0,0"/>
                                    <TextBlock Text="Exames e avaliação" FontSize="13" Foreground="#688077"/>
                                </StackPanel>
                            </Button>

                            <Button Click="FutureStep_Click" Style="{StaticResource StepCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="03" FontSize="32" FontWeight="Black" Foreground="#123322"/>
                                    <TextBlock Text="Terceira Etapa" FontWeight="Bold" FontSize="18" Foreground="#123322" Margin="0,4,0,0"/>
                                    <TextBlock Text="Testes de aptidão" FontSize="13" Foreground="#688077"/>
                                </StackPanel>
                            </Button>

                            <Button Click="FutureStep_Click" Style="{StaticResource StepCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="04" FontSize="32" FontWeight="Black" Foreground="#123322"/>
                                    <TextBlock Text="Quarta Etapa" FontWeight="Bold" FontSize="18" Foreground="#123322" Margin="0,4,0,0"/>
                                    <TextBlock Text="Entrevista técnica" FontSize="13" Foreground="#688077"/>
                                </StackPanel>
                            </Button>

                            <Button Click="FutureStep_Click" Style="{StaticResource StepCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="05" FontSize="32" FontWeight="Black" Foreground="#123322"/>
                                    <TextBlock Text="Quinta Etapa" FontWeight="Bold" FontSize="18" Foreground="#123322" Margin="0,4,0,0"/>
                                    <TextBlock Text="Designação final" FontSize="13" Foreground="#688077"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="RegisterViewBorder" Visibility="Collapsed" Background="White" CornerRadius="20" BorderBrush="#DFE7E2" BorderThickness="1" Padding="32">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#123322" Text="Cadastrar Conscrito (Etapa 01)" />
                            <TextBlock Margin="0,8,0,32" FontSize="15" Foreground="#63756E" Text="Preencha os dados iniciais. O candidato será adicionado à lista geral." />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Nome Completo" FontWeight="SemiBold"/>
                                    <TextBox x:Name="NameTextBox" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Data de Nascimento" FontWeight="SemiBold"/>
                                    <TextBox x:Name="BirthDateTextBox" Height="36" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Exemplo: 15/04/2006"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Nome da Mãe" FontWeight="SemiBold"/>
                                    <TextBox x:Name="MotherNameTextBox" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Nome do Pai" FontWeight="SemiBold"/>
                                    <TextBox x:Name="FatherNameTextBox" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Endereço" FontWeight="SemiBold"/>
                                    <TextBox x:Name="AddressTextBox" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Cidade" FontWeight="SemiBold"/>
                                    <TextBox x:Name="CityTextBox" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,16">
                                    <TextBlock Margin="0,0,0,6" Foreground="#355246" Text="Escolaridade" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="EducationComboBox" Height="36" Padding="8,6" SelectedIndex="0">
                                        <ComboBoxItem Content="Ensino fundamental" />
                                        <ComboBoxItem Content="Ensino médio" />
                                        <ComboBoxItem Content="Ensino técnico" />
                                        <ComboBoxItem Content="Ensino superior" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="RegisterFeedbackTextBlock" Margin="0,8,0,16" Foreground="#C43D3D" FontWeight="SemiBold" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal">
                                <Button Width="160" Height="40" 
                                        Style="{StaticResource RoundedPrimaryButton}" 
                                        Click="SaveConscriptButton_Click" 
                                        Content="Salvar Ficha" />

                                <Button Width="120" Height="40" Margin="16,0,0,0" 
                                        Style="{StaticResource RoundedSecondaryButton}" 
                                        Click="ClearFormButton_Click" 
                                        Content="Limpar" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="ListViewBorder" Visibility="Collapsed" Background="White" CornerRadius="20" BorderBrush="#DFE7E2" BorderThickness="1" Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,24">
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="#123322" Text="Lista de Candidatos" />
                            <TextBlock Margin="0,8,0,0" FontSize="15" Foreground="#63756E" Text="Todos os conscritos cadastrados no sistema." />
                        </StackPanel>

                        <DataGrid x:Name="ConscriptsDataGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#DFE7E2" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F4F2" RowBackground="White" AlternatingRowBackground="#FAFCFB" RowHeight="40">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F7F5" />
                                    <Setter Property="Foreground" Value="#123322" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#DFE7E2"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Width="1.5*" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Nascimento" Width="1*" Binding="{Binding BirthDate}" />
                                <DataGridTextColumn Header="Mãe" Width="1.5*" Binding="{Binding MotherName}" />
                                <DataGridTextColumn Header="Cidade" Width="1*" Binding="{Binding City}" />
                                <DataGridTextColumn Header="Escolaridade" Width="1.2*" Binding="{Binding Education}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>