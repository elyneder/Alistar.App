<Window x:Class="Alistar.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Alistar | Inicio"
        Height="720"
        Width="1220">
    <Grid Background="#F6F8F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White"
                Margin="24,24,24,18"
                Padding="24"
                CornerRadius="24"
                BorderBrush="#DFE7E2"
                BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="30"
                               FontWeight="Bold"
                               Foreground="#123322"
                               Text="Tela inicial do sistema Alistar" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="15"
                               Foreground="#688077"
                               Text="Acompanhamento geral do acesso e atalhos principais do sistema." />
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Width="130"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LogoutButton_Click"
                        Content="Sair" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    CornerRadius="24"
                    BorderBrush="#DFE7E2"
                    BorderThickness="1"
                    Padding="28"
                    Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock FontSize="24"
                               FontWeight="Bold"
                               Foreground="#123322"
                               Text="Bem-vindo ao Alistar" />
                    <TextBlock Margin="0,12,0,24"
                               FontSize="16"
                               Foreground="#63756E"
                               TextWrapping="Wrap"
                               Text="Depois do login, esta tela inicial pode exibir indicadores, lista de conscritos, avisos e acessos rapidos do sistema." />

                    <UniformGrid Columns="3" Margin="0,0,0,24">
                        <Border Margin="0,0,12,0" Padding="18" Background="#F3F7F5" CornerRadius="18">
                            <StackPanel>
                                <TextBlock Foreground="#6A7A73" Text="Usuarios" />
                                <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="Bold" Foreground="#123322" Text="128" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,12,0" Padding="18" Background="#F3F7F5" CornerRadius="18">
                            <StackPanel>
                                <TextBlock Foreground="#6A7A73" Text="Aguardando analise" />
                                <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="Bold" Foreground="#123322" Text="34" />
                            </StackPanel>
                        </Border>
                        <Border Padding="18" Background="#F3F7F5" CornerRadius="18">
                            <StackPanel>
                                <TextBlock Foreground="#6A7A73" Text="Convocados" />
                                <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="Bold" Foreground="#123322" Text="12" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Background="#0F291D"
                            CornerRadius="22"
                            Padding="24">
                        <StackPanel>
                            <TextBlock FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="Painel inicial pronto para evoluir" />
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="15"
                                       Foreground="#D1DDD6"
                                       TextWrapping="Wrap"
                                       Text="Se quiser, no proximo passo podemos ligar cadastro real, banco de dados e a listagem completa de conscritos." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Background="White"
                        CornerRadius="24"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        Padding="24"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#123322"
                                   Text="Atalhos" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cadastrar conscrito" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Consultar lista" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Gerar relatorio" />
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="24"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        Padding="24">
                    <StackPanel>
                        <TextBlock FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#123322"
                                   Text="Status do sistema" />
                        <TextBlock Margin="0,14,0,0" Foreground="#63756E" Text="Login ativo" />
                        <TextBlock Margin="0,8,0,0" Foreground="#63756E" Text="Base inicial carregada" />
                        <TextBlock Margin="0,8,0,0" Foreground="#63756E" Text="Layout atualizado com nova logo" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
