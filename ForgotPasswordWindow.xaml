<Window x:Class="Alistar.App.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Alistar | Recuperar senha"
        Height="360"
        Width="500"
        ResizeMode="NoResize">
    <Grid Background="#F6F8F7" Margin="28">
        <Border Background="White"
                BorderBrush="#DFE7E2"
                BorderThickness="1"
                CornerRadius="24"
                Padding="28">
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold" Foreground="#123322" Text="Esqueceu a senha?" />
                <TextBlock Margin="0,8,0,24"
                           Foreground="#667771"
                           TextWrapping="Wrap"
                           Text="Informe seu e-mail cadastrado para validar a recuperacao de acesso." />

                <TextBlock Margin="0,0,0,6" Text="E-mail" />
                <TextBox x:Name="RecoveryEmailTextBox" Style="{StaticResource InputTextBoxStyle}" />

                <TextBlock x:Name="FeedbackTextBlock"
                           Margin="0,6,0,12"
                           Foreground="#4B5A54"
                           TextWrapping="Wrap" />

                <Button Style="{StaticResource PrimaryButtonStyle}" Click="ValidateButton_Click" Content="Validar e-mail" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" Content="Fechar" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
