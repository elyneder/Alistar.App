<Window x:Class="Alistar.App.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Cadastro"
        Height="720"
        Width="1220"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid Background="#0F291D">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#196743" Offset="0" />
                    <GradientStop Color="#0F291D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <Border Background="#0F2B1E"
                            BorderBrush="#2A6644"
                            BorderThickness="2"
                            CornerRadius="20"
                            Padding="20"
                            Width="400"
                            Height="400">

                        <Image Source="Assets/a1.jpeg"
                               Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0">
                        <Ellipse Width="6" Height="6" Fill="#4CAF82" Margin="0,0,6,0"/>
                        <TextBlock FontSize="12"
                                   Foreground="#9ACFB5"
                                   Text="Alistar - Sistema de Gestão de Alistamento e Seleção Militar" />
                    </StackPanel>

                </StackPanel>

                <TextBlock VerticalAlignment="Bottom"
                           HorizontalAlignment="Left"
                           Margin="40,0,0,28"
                           FontSize="10"
                           Foreground="#2A4D38"
                           Text="ALISTAR  —  Uso restrito  —  Acesso autorizado" />
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#0F291D">
            <Grid>

                <Viewbox Stretch="Uniform" MaxWidth="460">
                    <Border Background="#F8FAF9"
                            Padding="24"
                            CornerRadius="10">

                        <StackPanel Width="320">

                            <TextBlock Text="Cadastrar conta"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2D26"
                                       TextAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Preencha os dados para criar sua conta."
                                       FontSize="12"
                                       Foreground="#5F7D6E"
                                       TextAlignment="Center"
                                       Margin="0,0,0,24"/>

                            <TextBlock Text="Nome"
                                       FontSize="11"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,4"/>

                            <Border Background="White"
                                    BorderBrush="#D5E3DC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,14">
                                <TextBox x:Name="NameTextBox"
                                         Padding="10"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#1F2D26"/>
                            </Border>

                            <TextBlock Text="E-mail"
                                       FontSize="11"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,4"/>

                            <Border Background="White"
                                    BorderBrush="#D5E3DC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,14">
                                <TextBox x:Name="RegisterEmailTextBox"
                                         Padding="10"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#1F2D26"/>
                            </Border>

                            <TextBlock Text="Senha"
                                       FontSize="11"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,4"/>

                            <Grid Margin="0,0,0,8">

                                <Border Background="White"
                                        BorderBrush="#D5E3DC"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <PasswordBox x:Name="RegisterPasswordTextBox"
                                                 Padding="10"
                                                 FontSize="13"
                                                 BorderThickness="0"
                                                 Background="Transparent"/>
                                </Border>

                                <Border Background="White"
                                        BorderBrush="#D5E3DC"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed"
                                        x:Name="RegisterPasswordVisibleBorder">
                                    <TextBox x:Name="RegisterPasswordVisible"
                                             Padding="10"
                                             FontSize="13"
                                             BorderThickness="0"
                                             Background="Transparent"/>
                                </Border>

                                <Button Content="👁"
                                        Width="26"
                                        Height="26"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="TogglePassword_Click"/>
                            </Grid>

                            <TextBlock x:Name="FeedbackTextBlock"
                                       Foreground="#D9534F"
                                       FontSize="11"
                                       Margin="0,4,0,8"/>

                            <Button Content="Salvar cadastro"
                                    Height="42"
                                    FontSize="13"
                                    Background="#196743"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,8,0,0"
                                    Click="RegisterButton_Click"/>

                            <Button Content="Cancelar"
                                    Height="42"
                                    FontSize="13"
                                    Background="#EAF1ED"
                                    Foreground="#145C3B"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,8,0,0"
                                    Click="CancelButton_Click"/>

                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#5F7D6E"
                                       Margin="0,16,0,0">
                                <Run Text="Já tem conta? "/>
                                <Hyperlink Foreground="#2E8B57"
                                           Click="BackToLogin_Click">
                                    Voltar para login
                                </Hyperlink>
                            </TextBlock>

                        </StackPanel>

                    </Border>
                </Viewbox>

            </Grid>
        </Border>
    </Grid>
</Window>