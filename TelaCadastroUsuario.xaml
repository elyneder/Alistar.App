<Window x:Class="Alistar.App.TelaCadastroUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Cadastro de Entrevistador"
        Height="720"
        Width="1220"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid Background="#0F291D">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#196743" Offset="0" />
                    <GradientStop Color="#0F291D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Border Background="#0F2B1E"
                            BorderBrush="#2A6644"
                            BorderThickness="2"
                            CornerRadius="20"
                            Padding="20"
                            Width="400"
                            Height="400">
                        <Image Source="Assets/a1.jpeg"
                               Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="#4CAF82"
                                 Margin="0,0,6,0" />
                        <TextBlock FontSize="12"
                                   Foreground="#9ACFB5"
                                   Text="Alistar - Sistema de Gestao de Alistamento e Selecao Militar" />
                    </StackPanel>
                </StackPanel>

                <TextBlock VerticalAlignment="Bottom"
                           HorizontalAlignment="Left"
                           Margin="40,0,0,28"
                           FontSize="10"
                           Foreground="#2A4D38"
                           Text="ALISTAR - Uso restrito - Acesso autorizado" />
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="#0F291D">
            <Grid>
                <Viewbox Stretch="Uniform"
                         MaxWidth="460">
                    <Border Background="#F8FAF9"
                            Padding="24"
                            CornerRadius="10">
                        <StackPanel Width="320">
                            <TextBlock Text="Registrar um novo entrevistador"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2D26"
                                       TextAlignment="Center"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="Somente o administrador principal pode criar um novo acesso de entrevistador."
                                       FontSize="12"
                                       Foreground="#5F7D6E"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,24" />

                            <TextBlock Text="Nome"
                                       FontSize="11"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,4" />

                            <Border Background="White"
                                    BorderBrush="#D5E3DC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,14">
                                <TextBox x:Name="CaixaTextoNomeUsuario"
                                         Padding="10"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#1F2D26" />
                            </Border>

                            <TextBlock Text="E-mail"
                                       FontSize="11"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,4" />

                            <Border Background="White"
                                    BorderBrush="#D5E3DC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,14">
                                <TextBox x:Name="CaixaTextoEmailUsuario"
                                         Padding="10"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#1F2D26" />
                            </Border>

                            <TextBlock Text="Senha"
                                       FontSize="11"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,4" />

                            <Grid Margin="0,0,0,8">
                                <Border Background="White"
                                        BorderBrush="#D5E3DC"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <PasswordBox x:Name="CaixaSenhaUsuario"
                                                 Padding="10"
                                                 FontSize="13"
                                                 BorderThickness="0"
                                                 Background="Transparent" />
                                </Border>

                                <Border x:Name="BordaSenhaVisivelUsuario"
                                        Background="White"
                                        BorderBrush="#D5E3DC"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                    <TextBox x:Name="CaixaTextoSenhaVisivelUsuario"
                                             Padding="10"
                                             FontSize="13"
                                             BorderThickness="0"
                                             Background="Transparent" />
                                </Border>

                                <Button Content="Ver"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource BotaoIconeStyle}"
                                        Click="AlternarSenhaBotao_Click" />
                            </Grid>

                            <TextBlock x:Name="TextoFeedbackCadastro"
                                       Foreground="#D9534F"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,8" />

                            <Button Content="Salvar entrevistador"
                                    Style="{StaticResource BotaoPrimarioStyle}"
                                    Click="SalvarCadastroBotao_Click" />

                            <Button Content="Cancelar"
                                    Style="{StaticResource BotaoSecundarioStyle}"
                                    Click="CancelarBotao_Click" />
                        </StackPanel>
                    </Border>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</Window>
