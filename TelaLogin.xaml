<Window x:Class="Alistar.App.TelaLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Acesso ao Sistema"
        Height="720"
        Width="1220"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">

    <Grid Background="#0F291D">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#196743" Offset="0" />
                    <GradientStop Color="#0F291D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <Border Background="#0F2B1E"
                            BorderBrush="#2A6644"
                            BorderThickness="2"
                            CornerRadius="20"
                            Padding="24"
                            Width="420"
                            Height="420">
                        <Image Source="Assets/a1.jpeg"
                               Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#4CAF82"
                                 Margin="0,0,8,0" />
                        <TextBlock FontSize="13"
                                   Foreground="#9ACFB5"
                                   Text="Alistar - Sistema de Gestao de Alistamento e Selecao Militar" />
                    </StackPanel>
                </StackPanel>

                <TextBlock VerticalAlignment="Bottom"
                           HorizontalAlignment="Left"
                           Margin="40,0,0,28"
                           FontSize="11"
                           Foreground="#2A4D38"
                           Text="ALISTAR - Uso restrito - Acesso autorizado" />
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="#0F291D">
            <Grid>
                <Viewbox Stretch="Uniform"
                         MaxWidth="520">
                    <Border Background="#F8FAF9"
                            Padding="28"
                            CornerRadius="12">
                        <StackPanel Width="360">
                            <TextBlock Text="Acesse sua conta"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2D26"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Entre com seu e-mail e senha para continuar."
                                       FontSize="13"
                                       Foreground="#5F7D6E"
                                       TextAlignment="Center"
                                       Margin="0,0,0,28" />

                            <TextBlock Text="E-mail"
                                       FontSize="12"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,6" />

                            <Border Background="White"
                                    BorderBrush="#D5E3DC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,18">
                                <TextBox x:Name="CaixaTextoEmail"
                                         Padding="12"
                                         FontSize="14"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#1F2D26" />
                            </Border>

                            <TextBlock Text="Senha"
                                       FontSize="12"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,10">
                                <Border Background="White"
                                        BorderBrush="#D5E3DC"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <PasswordBox x:Name="CaixaSenha"
                                                 Padding="12"
                                                 FontSize="14"
                                                 BorderThickness="0"
                                                 Background="Transparent" />
                                </Border>

                                <Border x:Name="BordaSenhaVisivel"
                                        Background="White"
                                        BorderBrush="#D5E3DC"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                    <TextBox x:Name="CaixaTextoSenhaVisivel"
                                             Padding="12"
                                             FontSize="14"
                                             BorderThickness="0"
                                             Background="Transparent" />
                                </Border>

                                <Button Content="Ver"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource BotaoIconeStyle}"
                                        Click="AlternarSenhaBotao_Click" />
                            </Grid>

                            <TextBlock x:Name="TextoFeedback"
                                       Foreground="#D9534F"
                                       FontSize="12"
                                       Margin="0,5,0,10" />

                            <Button Content="Entrar"
                                    Style="{StaticResource BotaoPrimarioStyle}"
                                    IsDefault="True"
                                    Click="EntrarBotao_Click" />
                        </StackPanel>
                    </Border>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</Window>
