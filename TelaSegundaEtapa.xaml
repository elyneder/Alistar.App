<Window x:Class="Alistar.App.TelaSegundaEtapa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Segunda Etapa"
        Height="760"
        Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="TituloSecaoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#111111" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="TituloBlocoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DescricaoBlocoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A5F66" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,22" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RotuloCampoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="LinhaCamposStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="PainelVerticalStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="LinhaCampoStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#111111" />
            <Setter Property="BorderThickness" Value="0,0,0,1.2" />
            <Setter Property="Padding" Value="2,2,2,3" />
        </Style>

        <Style x:Key="CampoTextoStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#111111" />
        </Style>

        <Style x:Key="CampoTextoMultilinhaStyle" TargetType="TextBox" BasedOn="{StaticResource CampoTextoStyle}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <Style x:Key="CampoComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style x:Key="CaixaSecaoStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B1E14"
                CornerRadius="0,24,24,0">
            <Grid Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,40"
                            HorizontalAlignment="Center">
                    <Border Width="110"
                            Height="110"
                            CornerRadius="20"
                            BorderBrush="#2A6644"
                            BorderThickness="2"
                            Margin="0,0,0,16">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/a1.jpeg"
                                        Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <TextBlock Text="ALISTAR"
                               FontSize="26"
                               FontWeight="Black"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sistema de Conscritos"
                               FontSize="12"
                               Foreground="#688077"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="BotaoTelaInicial"
                            Content=" 🏠︎ Tela Inicial"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarTelaInicialBotao_Click" />

                    <Button x:Name="BotaoListaConscritos"
                            Content=" 🔍︎Consultar Lista"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarListaConscritosBotao_Click" />

                    <Border Margin="0,30,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#163626">
                        <StackPanel>
                            <TextBlock Text="Total Cadastrados"
                                       Foreground="#8BA698"
                                       FontSize="12" />
                            <TextBlock x:Name="TextoQuantidadeConscritos"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content=" 👤Cadastrar Entrevistador"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Margin="0,0,0,12"
                            Click="AbrirCadastroUsuarioBotao_Click" />

                    <Button Content=" ➜] Sair do Sistema"
                            Style="{StaticResource BotaoPerigoTextoStyle}"
                            Click="SairSistemaBotao_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">
                <TextBlock Text="Segunda Etapa"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#123322" />
                <TextBlock Text="Avaliacao medica do conscrito."
                           FontSize="15"
                           Foreground="#688077"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#EEF2EF"
                    CornerRadius="20"
                    BorderBrush="#DFE7E2"
                    BorderThickness="1"
                    Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="980"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Segunda Etapa - Avaliacao Medica"
                                   Style="{StaticResource TituloBlocoStyle}" />
                        <TextBlock Text="Preencha os exames e observacoes medicas do conscrito."
                                   Style="{StaticResource DescricaoBlocoStyle}" />

                        <Border Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="IDENTIFICACAO DO CONSCRITO"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Nome:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoNome" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="CPF:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoCPF" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RA:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoRA" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="1. AVALIACAO FISICA"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Altura:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoAltura" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="Peso:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoPeso" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Problema de postura:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboProblemaPostura" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Nao" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Style="{StaticResource PainelVerticalStyle}">
                                    <TextBlock Text="Observacao do medico:" Style="{StaticResource RotuloCampoStyle}" />
                                    <Border Style="{StaticResource LinhaCampoStyle}">
                                        <TextBox x:Name="CaixaTextoObservacaoPostura" Style="{StaticResource CampoTextoMultilinhaStyle}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="2. VISAO"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <StackPanel Style="{StaticResource PainelVerticalStyle}">
                                    <TextBlock Text="O conscrito precisa de oculos ou tem dificuldade visual:" Style="{StaticResource RotuloCampoStyle}" />
                                    <Border Style="{StaticResource LinhaCampoStyle}">
                                        <ComboBox x:Name="ComboDificuldadeVisual" Style="{StaticResource CampoComboStyle}">
                                            <ComboBoxItem Content="Selecione" />
                                            <ComboBoxItem Content="Sim" />
                                            <ComboBoxItem Content="Nao" />
                                        </ComboBox>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="3. TESTE AUDITIVO"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Alteracao auditiva:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboTesteAuditivo" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Nao" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Observacao:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoObservacaoAuditiva" Style="{StaticResource CampoTextoMultilinhaStyle}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="4. EXAME GERAL"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Pressao arterial:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoPressaoArterial" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="Frequencia cardiaca:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoFrequenciaCardiaca" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Respiracao:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoRespiracao" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="5. HISTORICO MEDICO"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Alguem da sua familia tem doencas graves:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboDoencasGravesFamilia" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Nao" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Ja teve problema cardiaco ou respiratorio:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboProblemaCardiacoRespiratorio" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Nao" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="6. SAUDE MENTAL"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Ja teve ansiedade, depressao ou acompanhamento psicologico:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboSaudeMental" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Nao" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Tem dificuldade para dormir:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboDificuldadeDormir" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Nao" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TextoFeedback"
                                   Margin="0,8,0,16"
                                   Foreground="#C43D3D"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal">
                            <Button Width="180"
                                    Style="{StaticResource BotaoPrimarioStyle}"
                                    Click="SalvarBotao_Click"
                                    Content="Salvar Ficha" />

                            <Button Width="120"
                                    Margin="16,8,0,0"
                                    Style="{StaticResource BotaoSecundarioStyle}"
                                    Click="LimparBotao_Click"
                                    Content="Limpar" />

                            <Button Width="120"
                                    Margin="16,8,0,0"
                                    Style="{StaticResource BotaoSecundarioStyle}"
                                    Click="FecharBotao_Click"
                                    Content="Fechar" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
