<Window x:Class="Alistar.App.TelaSegundaEtapa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Segunda Etapa"
        Height="520"
        Width="860"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F4F7F6">
        <Border Margin="24"
                Padding="28"
                Background="White"
                CornerRadius="18"
                BorderBrush="#DFE7E2"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Segunda Etapa"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#123322" />
                    <TextBlock Text="Tela separada para exames e avaliacao do conscrito."
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#5A5F66" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,28,0,28"
                        Padding="22"
                        Background="#EEF2EF"
                        CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="Estrutura pronta para a 2a etapa."
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#123322" />
                        <TextBlock Text="Aqui voce pode evoluir o formulario medico sem misturar a regra com o Painel de Controle."
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#4B5563" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="120"
                            Style="{StaticResource BotaoSecundarioStyle}"
                            Click="FecharBotao_Click"
                            Content="Fechar" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
