<Window x:Class="Alistar.App.TelaCadastroUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Cadastro de Entrevistador"
        Height="720"
        Width="1220"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Icon="/Views/Assets/alistar_icone.ico">

    <!-- Tela modal de cadastro: identidade visual a esquerda e campos do entrevistador a direita. -->
    <Grid Background="#0F291D">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#196743" Offset="0" />
                    <GradientStop Color="#0F291D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Border Background="#0F2B1E"
                            BorderBrush="#2A6644"
                            BorderThickness="2"
                            CornerRadius="20"
                            Padding="20"
                            Width="400"
                            Height="400">
                        <Image Source="Assets/a1.jpeg"
                               Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0">
                        <Ellipse Width="6"
                                 Height="6"
                                 Fill="#4CAF82"
                                 Margin="0,0,6,0" />
                        <TextBlock FontSize="12"
                                   Foreground="#9ACFB5"
                                   Text="Alistar - Sistema de Gestão de Alistamento e Seleção Militar" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="#0F291D">
            <Grid>
                <Viewbox Stretch="Uniform"
                         MaxWidth="460">
                    <Border Background="#F8FAF9"
                            Padding="20"
                            CornerRadius="10" Height="513">
                        <StackPanel Width="320">
                            <TextBlock
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2D26"
                                       TextAlignment="Center"
                                       Margin="0,0,0,6" ><Run Text="Registrar "/><Run Language="pt-br" Text="E"/><Run Text="ntrevistador"/></TextBlock>

                            <TextBlock Text="Somente o administrador principal pode criar um novo acesso de entrevistador."
                                       FontSize="12"
                                       Foreground="#5F7D6E"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Nome"
                                       FontSize="11"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,4" />

                            <Border Background="White"
                                    BorderBrush="#D5E3DC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,10">
                                <TextBox x:Name="CaixaTextoNomeUsuario"
                                         Padding="10"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#1F2D26" MaxLength="40" Height="25" />
                            </Border>

                            <TextBlock Text="E-mail"
                                       FontSize="11"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,4" />

                            <Border Background="White"
                                    BorderBrush="#D5E3DC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,10">
                                <TextBox x:Name="CaixaTextoEmailUsuario"
                                         Padding="10"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#1F2D26" MaxLength="30" Height="25"/>
                            </Border>

                            <TextBlock Text="Senha"
                                       FontSize="11"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,4" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="133*"/>
                                    <ColumnDefinition Width="27*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="White"
                                        BorderBrush="#D5E3DC"
                                        BorderThickness="1"
                                        CornerRadius="6" Grid.ColumnSpan="2">
                                    <PasswordBox x:Name="CaixaSenhaUsuario"
                                                 Padding="10"
                                                 FontSize="13"
                                                 BorderThickness="0"
                                                 Background="Transparent" MaxLength="30" Height="25"/>
                                </Border>

                                <Border x:Name="BordaSenhaVisivelUsuario"
                                        Background="White"
                                        BorderBrush="#D5E3DC"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed" Grid.ColumnSpan="2">
                                    <TextBox x:Name="CaixaTextoSenhaVisivelUsuario"
                                             Padding="10"
                                             FontSize="13"
                                             BorderThickness="0"
                                             Background="Transparent" MaxLength="30" Height="25"/>
                                </Border>

                                <Button HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="15,0,0,0"
                                    Style="{StaticResource BotaoIconeStyle}"
                                    Click="AlternarSenhaBotao_Click" Grid.Column="1" Height="26" Width="33">
                                    <Button.Content>
                                        <Grid Width="20" Height="20">
                                            <Path x:Name="IconeOlhoAberto"
                                               Fill="#4A6658"
                                               Data="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5C21.3 7.6 17 4.5 12 4.5zm0 12.5c-2.8 0-5-2.2-5-5s2.2-5 5-5 5 2.2 5 5-2.2 5-5 5zm0-8c-1.7 0-3 1.3-3 3s1.3 3 3 3 3-1.3 3-3-1.3-3-3-3z"
                                               Stretch="Uniform"
                                               Visibility="Visible"/>
                                            <Path x:Name="IconeOlhoFechado"
                                               Fill="#4A6658"
                                               Data="M12 7c2.8 0 5 2.2 5 5 0 .6-.1 1.2-.3 1.8l3 3c1.5-1.3 2.7-3 3.3-4.8C21.3 7.6 17 4.5 12 4.5c-1.4 0-2.7.3-3.9.7l2.2 2.2C10.8 7.1 11.4 7 12 7zM2 4.3l2.3 2.3.5.5C3.1 8.5 1.8 10.1 1 12c1.7 4.4 6 7.5 11 7.5 1.6 0 3.1-.3 4.5-.9l.4.4L19.7 21 21 19.7 3.3 3 2 4.3zm5.5 5.5l1.6 1.6c-.1.2-.1.4-.1.6 0 1.7 1.3 3 3 3 .2 0 .4 0 .6-.1l1.6 1.6c-.7.3-1.4.5-2.2.5-2.8 0-5-2.2-5-5 0-.8.2-1.5.5-2.2z"
                                               Stretch="Uniform"
                                               Visibility="Collapsed"/>
                                        </Grid>
                                    </Button.Content>
                                </Button>
                            </Grid>

                            <TextBlock Text="CRM do Médico"
                                    FontSize="11"
                                    Foreground="#4A6658"
                                    Margin="0,0,0,4" />

                            <Border Background="White"
                                    BorderBrush="#D5E3DC"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <TextBox x:Name="CaixaCRMMedico"
                                    Padding="10"
                                    FontSize="13"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="#1F2D26" MaxLength="30" Height="25"/>
                            </Border>

                            <TextBlock x:Name="TextoFeedbackCadastro"
                                    Foreground="#D9534F"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    Margin="0,10,0,0" />

                            <Button Content="Administrador"
                            Style="{StaticResource BotaoPrimarioStyle}"
                            Height="40" Width="100" HorizontalAlignment="Left"
                            Margin="0,10,0,5"/>

                            <Button Content="Entrevistador"
                            Style="{StaticResource BotaoPrimarioStyle}"
                            Height="40" Width="100" HorizontalAlignment="Center"
                            Margin="0,-140,0,-90"/>

                            <Button Content="Médico"
                            Style="{StaticResource BotaoPrimarioStyle}"
                            Height="40" Width="100" HorizontalAlignment="Right"
                            Margin="0,-140,0,-90"/>

                            <Button Content="Salvar Usuário"
                                    Style="{StaticResource BotaoPrimarioStyle}"
                                    Click="SalvarCadastroBotao_Click" Height="40" Width="320"/>

                            <Button Content="Cancelar"
                                    Style="{StaticResource BotaoSecundarioStyle}"
                                    Click="CancelarBotao_Click" Height="40" Width="320"/>
                        </StackPanel>
                    </Border>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</Window>
