<Window x:Class="Alistar.App.TelaConfiguracaoProcesso"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Configuração do Processo"
        Height="760"
        Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Views/Assets/alistar_icone.ico">

    <Window.Resources>
        <Style x:Key="TituloSecaoPapelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#111111" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="TituloBlocoPapelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DescricaoBlocoPapelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A5F66" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,22" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RotuloCampoDocumentoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Height" Value="36" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="PainelCampoDocumentoStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,26,18" />
        </Style>

        <Style x:Key="LinhaCampoDocumentoStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#111111" />
            <Setter Property="BorderThickness" Value="0,0,0,1.2" />
            <Setter Property="Padding" Value="2,2,2,3" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style x:Key="CampoTextoDocumentoStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#111111" />
        </Style>

        <Style x:Key="CaixaSecaoDocumentoStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CartaoEtapaWizardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E1DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="NumeroEtapaWizardStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#123322" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="TituloEtapaWizardStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#123322" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="DescricaoEtapaWizardStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F7168" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="CartaoServidorStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDE7E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Background" Value="#F8FBF9" />
        </Style>

        <Style x:Key="CheckBoxServidorStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B1E14"
                CornerRadius="0,24,24,0">
            <Grid Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,40"
                            HorizontalAlignment="Center">
                    <Image Source="/Views/Assets/2-semfundo.png"
                           Width="177"
                           Height="133"
                           Stretch="UniformToFill" />
                    <TextBlock Text="Sistema de Conscritos"
                               FontSize="12"
                               Foreground="#688077"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1"/>

                <StackPanel Grid.Row="2">
                    <Button Content=" ➜ Sair do Sistema"
                            Style="{StaticResource BotaoPerigoTextoStyle}"
                            Click="SairSistemaBotao_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">
                <TextBlock Text="Configuração do Processo"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#123322" />
                <TextBlock x:Name="TextoDescricaoCabecalho"
                           Text="Preencha os dados iniciais antes de abrir o painel principal."
                           FontSize="15"
                           Foreground="#688077"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#EEF2EF"
                    CornerRadius="20"
                    BorderBrush="#DFE7E2"
                    BorderThickness="1"
                    Padding="22">
                <ScrollViewer x:Name="ScrollFormularioConfiguracao"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1080"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="TextoTituloFormulario"
                                   Text="Dados Gerais"
                                   Style="{StaticResource TituloBlocoPapelStyle}"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="TextoDescricaoFormulario"
                                   Text="Informe os dados principais do processo seletivo."
                                   Style="{StaticResource DescricaoBlocoPapelStyle}"
                                   TextAlignment="Center" />

                        <UniformGrid Columns="4"
                                     Margin="0,0,0,20">
                            <Border x:Name="CartaoWizardDados" Style="{StaticResource CartaoEtapaWizardStyle}">
                                <StackPanel>
                                    <TextBlock Text="01" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                    <TextBlock Text="Dados gerais" Style="{StaticResource TituloEtapaWizardStyle}" />
                                    <TextBlock Text="Abertura e limites" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="CartaoWizardEtapas" Style="{StaticResource CartaoEtapaWizardStyle}">
                                <StackPanel>
                                    <TextBlock Text="02" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                    <TextBlock Text="Etapas" Style="{StaticResource TituloEtapaWizardStyle}" />
                                    <TextBlock Text="Percentuais de saída" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="CartaoWizardServidores" Style="{StaticResource CartaoEtapaWizardStyle}">
                                <StackPanel>
                                    <TextBlock Text="03" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                    <TextBlock Text="Entrevistadores" Style="{StaticResource TituloEtapaWizardStyle}" />
                                    <TextBlock Text="Permissão geral" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="CartaoWizardConfirmacao" Style="{StaticResource CartaoEtapaWizardStyle}">
                                <StackPanel>
                                    <TextBlock Text="04" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                    <TextBlock Text="Confirmação" Style="{StaticResource TituloEtapaWizardStyle}" />
                                    <TextBlock Text="Revisão final" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border x:Name="PainelDadosGerais" Style="{StaticResource CaixaSecaoDocumentoStyle}">
                            <StackPanel>
                                <TextBlock Text="DADOS GERAIS DO PROCESSO"
                                           Style="{StaticResource TituloSecaoPapelStyle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Style="{StaticResource PainelCampoDocumentoStyle}">
                                        <TextBlock Text="Data de abertura" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <DatePicker x:Name="DataAberturaPicker"
                                                        SelectedDateChanged="DataAberturaPicker_SelectedDateChanged"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        FontSize="14" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Style="{StaticResource PainelCampoDocumentoStyle}">
                                        <TextBlock Text="Data de fechamento" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <DatePicker x:Name="DataFechamentoPicker"
                                                        SelectedDateChanged="DataFechamentoPicker_SelectedDateChanged"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        FontSize="14" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Style="{StaticResource PainelCampoDocumentoStyle}">
                                        <TextBlock Text="Data de nascimento limite" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <TextBox x:Name="CaixaAnoLimite"
                                                     MaxLength="4"
                                                     Style="{StaticResource CampoTextoDocumentoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Style="{StaticResource PainelCampoDocumentoStyle}">
                                        <TextBlock Text="Total de classificados" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <TextBox x:Name="CaixaTotalClassificados"
                                                     PreviewTextInput="CampoNumerico_PreviewTextInput"
                                                     DataObject.Pasting="CampoNumerico_Pasting"
                                                     Style="{StaticResource CampoTextoDocumentoStyle}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PainelEtapas"
                                Visibility="Collapsed"
                                Style="{StaticResource CaixaSecaoDocumentoStyle}">
                            <StackPanel>
                                <TextBlock Text="PERCENTUAL DE SAÍDA POR ETAPA"
                                           Style="{StaticResource TituloSecaoPapelStyle}" />

                                <ItemsControl x:Name="ListaEtapasPercentuais">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDE7E1"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="16"
                                                    Margin="0,0,0,12"
                                                    Background="#F8FBF9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="160" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Numero, StringFormat=Etapa {0}}"
                                                               FontWeight="Bold"
                                                               Foreground="#123322"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Nome}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="#111111"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="% que sai"
                                                                   Style="{StaticResource RotuloCampoDocumentoStyle}"
                                                                   Height="Auto" />
                                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                                            <TextBox Text="{Binding PercentualEliminacao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     MaxLength="2"
                                                                     PreviewTextInput="CampoNumerico_PreviewTextInput"
                                                                     DataObject.Pasting="CampoNumerico_Pasting"
                                                                     Style="{StaticResource CampoTextoDocumentoStyle}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PainelServidores"
                                Visibility="Collapsed"
                                Style="{StaticResource CaixaSecaoDocumentoStyle}">
                            <StackPanel>
                                <TextBlock Text="ENTREVISTADORES AUTORIZADOS"
                                           Style="{StaticResource TituloSecaoPapelStyle}" />
                                <TextBlock Text="A seleção abaixo vale para todas as etapas do processo."
                                           Style="{StaticResource DescricaoBlocoPapelStyle}" />

                                <ItemsControl x:Name="ListaServidores">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CartaoServidorStyle}">
                                                <CheckBox Content="{Binding Rotulo}"
                                                          IsChecked="{Binding Selecionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource CheckBoxServidorStyle}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PainelConfirmacao"
                                Visibility="Collapsed"
                                Style="{StaticResource CaixaSecaoDocumentoStyle}">
                            <StackPanel>
                                <TextBlock Text="CONFIRMAÇÃO FINAL"
                                           Style="{StaticResource TituloSecaoPapelStyle}" />

                                <TextBlock Text="Confira os dados antes de concluir a configuração do processo."
                                           Style="{StaticResource DescricaoBlocoPapelStyle}" />

                                <TextBlock x:Name="TextoResumoConfirmacao"
                                           Foreground="#111111"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14" />
                                <TextBlock x:Name="TextoEtapasConfirmacao"
                                           Foreground="#111111"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14" />
                                <TextBlock x:Name="TextoServidoresConfirmacao"
                                           Foreground="#111111"
                                           FontSize="15"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,4,0,0">
                            <TextBlock x:Name="TextoFeedback"
                                       Foreground="#C0392B"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button x:Name="BotaoAnterior"
                                        Content="Anterior"
                                        Width="120"
                                        Style="{StaticResource BotaoSecundarioStyle}"
                                        Click="AnteriorBotao_Click" />
                                <Button x:Name="BotaoProximo"
                                        Content="Próximo"
                                        Width="120"
                                        Style="{StaticResource BotaoPrimarioStyle}"
                                        Margin="10,8,0,0"
                                        Click="ProximoBotao_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
