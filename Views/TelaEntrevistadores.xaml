<Window x:Class="Alistar.App.TelaEntrevistadores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Entrevistadores"
        Height="760"
        Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B1E14"
                CornerRadius="0,24,24,0">
            <Grid Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,40"
                            HorizontalAlignment="Center">
                    <Image Source="/Views/Assets/2-semfundo.png"
                           Width="177"
                           Height="133"
                           Stretch="UniformToFill"/>
                    <TextBlock Text="Sistema de Conscritos"
                               FontSize="12"
                               Foreground="#688077"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content="Tela Inicial"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarTelaInicialBotao_Click" />

                    <Button Content="Cadastrar Entrevistador"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="AbrirCadastroUsuarioBotao_Click" />

                    <Border Margin="0,30,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#163626">
                        <StackPanel>
                            <TextBlock Text="Entrevistadores Cadastrados"
                                       Foreground="#8BA698"
                                       FontSize="12" />
                            <TextBlock x:Name="TextoTotalEntrevistadores"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="Sair do Sistema"
                            Style="{StaticResource BotaoPerigoTextoStyle}"
                            Click="SairSistemaBotao_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">
                <Button HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Style="{StaticResource BotaoSecundarioStyle}"
                        Click="MostrarTelaInicialBotao_Click">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="14" Height="14" Margin="0,0,6,0">
                            <Line X1="8" Y1="1" X2="1" Y2="7" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="1" Y1="7" X2="8" Y2="13" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="1" Y1="7" X2="13" Y2="7" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                        <TextBlock Text="Voltar ao Painel"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Entrevistadores"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#123322" />
                <TextBlock x:Name="TextoResumoEntrevistadores"
                           Text="Usuários cadastrados pelo administrador."
                           FontSize="15"
                           Foreground="#688077"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DFE7E2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <DataGrid x:Name="GradeEntrevistadores"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF2EF"
                          RowHeight="42"
                          AlternatingRowBackground="#F8FBF9"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*" />
                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
