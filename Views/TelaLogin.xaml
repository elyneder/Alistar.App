<Window x:Class="Alistar.App.TelaLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Acesso ao Sistema"
        Height="720"
        Width="1220"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Icon="/Views/Assets/2-semfundo.png">

    <Grid Background="#0F291D">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#196743" Offset="0" />
                    <GradientStop Color="#0F291D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <Border Background="#0F2B1E"
                            BorderBrush="#2A6644"
                            BorderThickness="2"
                            CornerRadius="20"
                            Padding="24"
                            Width="420"
                            Height="420">
                        <Image Source="./Assets/1.png"
                               Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="#4CAF82"
                                 Margin="0,0,8,0" />
                        <TextBlock FontSize="13"
                                   Foreground="#9ACFB5"
                                   Text="Alistar - Sistema de Gestão de Alistamento e Seleção Militar" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="#0F291D">
            <Grid>
                <Viewbox Stretch="Uniform"
                         MaxWidth="460">
                    <Border Background="#F8FAF9"
                            Padding="28"
                            CornerRadius="12">
                        <StackPanel Width="360">
                            <TextBlock Text="Acesse sua conta"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2D26"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Entre com seu e-mail e senha para continuar."
                                       FontSize="13"
                                       Foreground="#5F7D6E"
                                       TextAlignment="Center"
                                       Margin="0,0,0,28" />

                            <TextBlock Text="E-mail"
                                       FontSize="12"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,6" />

                            <Border Background="White"
                                    BorderBrush="#D5E3DC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,18">
                                <TextBox x:Name="CaixaTextoEmail"
                                         Padding="12"
                                         FontSize="14"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#1F2D26" />
                            </Border>

                            <TextBlock Text="Senha"
                                       FontSize="12"
                                       Foreground="#4A6658"
                                       Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,10">
                                <Border Background="White"
                                        BorderBrush="#D5E3DC"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <PasswordBox x:Name="CaixaSenha"
                                                 Padding="12"
                                                 FontSize="14"
                                                 BorderThickness="0"
                                                 Background="Transparent" />
                                </Border>

                                <Border x:Name="BordaSenhaVisivel"
                                        Background="White"
                                        BorderBrush="#D5E3DC"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                    <TextBox x:Name="CaixaTextoSenhaVisivel"
                                             Padding="12"
                                             FontSize="14"
                                             BorderThickness="0"
                                             Background="Transparent" />
                                </Border>

                                <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource BotaoIconeStyle}"
                                    Click="AlternarSenhaBotao_Click">
                                    <Button.Content>
                                        <Grid Width="20" Height="20">
                                            <Path x:Name="IconeOlhoAberto"
                                                Fill="#4A6658"
                                                Data="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5C21.3 7.6 17 4.5 12 4.5zm0 12.5c-2.8 0-5-2.2-5-5s2.2-5 5-5 5 2.2 5 5-2.2 5-5 5zm0-8c-1.7 0-3 1.3-3 3s1.3 3 3 3 3-1.3 3-3-1.3-3-3-3z"
                                                Stretch="Uniform"
                                                Visibility="Visible"/>
                                            <Path x:Name="IconeOlhoFechado"
                                                Fill="#4A6658"
                                                Data="M12 7c2.8 0 5 2.2 5 5 0 .6-.1 1.2-.3 1.8l3 3c1.5-1.3 2.7-3 3.3-4.8C21.3 7.6 17 4.5 12 4.5c-1.4 0-2.7.3-3.9.7l2.2 2.2C10.8 7.1 11.4 7 12 7zM2 4.3l2.3 2.3.5.5C3.1 8.5 1.8 10.1 1 12c1.7 4.4 6 7.5 11 7.5 1.6 0 3.1-.3 4.5-.9l.4.4L19.7 21 21 19.7 3.3 3 2 4.3zm5.5 5.5l1.6 1.6c-.1.2-.1.4-.1.6 0 1.7 1.3 3 3 3 .2 0 .4 0 .6-.1l1.6 1.6c-.7.3-1.4.5-2.2.5-2.8 0-5-2.2-5-5 0-.8.2-1.5.5-2.2z"
                                                Stretch="Uniform"
                                                Visibility="Collapsed"/>
                                        </Grid>
                                    </Button.Content>
                                </Button>
                            </Grid>

                            <TextBlock HorizontalAlignment="Center"
                               Margin="0,0,2,10">
                               <Hyperlink Foreground="#2E7D52"
                                TextDecorations="None"
                                FontSize="14"
                                Click="EsqueceuSenhaBotao_Click">Esqueceu a senha?</Hyperlink>
                            </TextBlock>

                            <TextBlock x:Name="TextoFeedback"
                                Foreground="#D9534F"
                                FontSize="12"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                Margin="0,4,0,4" />

                            <Button Content="Entrar"
                                    Style="{StaticResource BotaoPrimarioStyle}"
                                    IsDefault="True"
                                    Click="EntrarBotao_Click" />
                        </StackPanel>
                    </Border>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</Window>
