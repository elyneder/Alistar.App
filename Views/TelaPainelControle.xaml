<Window x:Class="Alistar.App.TelaPainelControle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Painel de Controle"
        Height="760"
        Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CaixaPesquisaListaStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="460" />
            <Setter Property="Height" Value="34" />
            <Setter Property="BorderBrush" Value="#D5DDD8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="CheckBoxFiltroStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BotaoConsultaCompactoStyle" TargetType="Button" BasedOn="{StaticResource BotaoSecundarioStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B1E14"
                CornerRadius="0,24,24,0">
            <Grid Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,40"
                            HorizontalAlignment="Center">
                    <Image Source="./Assets/2-semfundo.png"
                        Width="177"
                        Height="133"
                        Stretch="UniformToFill"/>
                    <TextBlock Text="Sistema de Conscritos"
                               FontSize="12"
                               Foreground="#688077"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="BotaoTelaInicial"
                            Content=" 🏠︎ Tela Inicial"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarTelaInicialBotao_Click" />

                    <Button x:Name="BotaoListaConscritos"
                            Content=" 🔍︎ Consultar Lista"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarListaConscritosBotao_Click" />

                    <Border Margin="0,30,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#163626">
                        <StackPanel>
                            <TextBlock Text="Total de Conscritos Cadastrados"
                                       Foreground="#8BA698"
                                       FontSize="12" />
                            <TextBlock x:Name="TextoQuantidadeConscritos"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="CadastrarEntrevistador" Content=" 👤 Cadastrar Entrevistador"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Margin="0,0,0,12"
                            Click="AbrirCadastroUsuarioBotao_Click" />

                    <Button Content=" ➜] Sair do Sistema"
                        Style="{StaticResource BotaoPerigoTextoStyle}"
                        Click="SairSistemaBotao_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">
                <TextBlock Text="Painel de Controle"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#123322" />
                <TextBlock Text="Use o painel como hub e abra cada etapa em sua própria tela."
                           FontSize="15"
                           Foreground="#688077"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="VisaoInicial"
                              Visibility="Visible"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Fluxo de Etapas"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#123322"
                                   Margin="0,0,0,16" />

                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource BotaoEtapaStyle}"
                                    Click="PrimeiraEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="01"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Cadastrar Conscrito"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Registro completo de dados pessoais e perfil do candidato"
                                               FontSize="14"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoEtapaStyle}"
                                    Click="SegundaEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="02"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Exames Médicos"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Avaliação clínica e laudos de aptidão física"
                                               FontSize="14"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoEtapaStyle}"
                                    Click="TerceiraEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="03"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Testes de Aptidão"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Avaliação de habilidades e competências"
                                               FontSize="14"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoEtapaStyle}"
                                    Click="QuartaEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="04"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Entrevista Técnica"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Avaliação comportamental e perfil profissional"
                                               FontSize="14"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoEtapaStyle}"
                                    Click="QuintaEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="05"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Designação Final"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Classificação e atribuição de função ao conscrito"
                                               FontSize="14"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="VisaoListaConscritos"
                        Visibility="Collapsed"
                        Background="White"
                        CornerRadius="20"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,24">
                            <TextBlock FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#123322"
                                       Text="Lista de Candidatos" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="15"
                                       Foreground="#63756E"
                                       Text="Selecione um conscrito para abrir a Primeira Etapa em uma tela separada." />
                            <TextBlock x:Name="TextoResumoLista"
                                       Margin="0,8,0,0"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Text="0 conscritos encontrados." />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,0,0,20"
                                Padding="18"
                                Background="#F8FAF9"
                                BorderBrush="#E3EBE6"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,12">
                                    <TextBox x:Name="CaixaPesquisaConscrito"
                                             Style="{StaticResource CaixaPesquisaListaStyle}"
                                             KeyDown="CaixaPesquisaConscrito_KeyDown"
                                             ToolTip="Pesquise por nome, CPF ou RA" />

                                    <Button Width="94"
                                            Style="{StaticResource BotaoConsultaCompactoStyle}"
                                            Click="PesquisarConscritoBotao_Click"
                                            Content="Pesquisar" />

                                    <Button x:Name="BotaoAlternarFiltros"
                                            Width="96"
                                            Style="{StaticResource BotaoConsultaCompactoStyle}"
                                            Click="AlternarFiltrosBotao_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas x:Name="IconeFiltros" Width="14" Height="14" Margin="0,0,6,0" Visibility="Visible">
                                                <Line X1="0" Y1="2" X2="14" Y2="2" Stroke="#196743" StrokeThickness="1.5"/>
                                                <Line X1="2" Y1="6" X2="12" Y2="6" Stroke="#196743" StrokeThickness="1.5"/>
                                                <Line X1="4" Y1="10" X2="10" Y2="10" Stroke="#196743" StrokeThickness="1.5"/>
                                            </Canvas>
                                            <Canvas x:Name="IconeOcultar" Width="14" Height="14" Margin="0,0,6,0" Visibility="Collapsed">
                                                <Ellipse Canvas.Left="2" Canvas.Top="4" Width="10" Height="6"
                                                         Stroke="#196743" StrokeThickness="1.5" Fill="Transparent"/>
                                                <Ellipse Canvas.Left="5" Canvas.Top="5.5" Width="4" Height="4"
                                                         Stroke="#196743" StrokeThickness="1" Fill="Transparent"/>
                                                <Line X1="1" Y1="13" X2="13" Y2="1" Stroke="#196743" StrokeThickness="1.5"/>
                                            </Canvas>
                                            <TextBlock x:Name="TextoBotaoFiltros" Text="Filtros"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Width="78"
                                            Style="{StaticResource BotaoConsultaCompactoStyle}"
                                            Click="LimparFiltrosBotao_Click"
                                            Content="Limpar" />
                                </WrapPanel>

                                <Border x:Name="PainelFiltrosRapidos"
                                        Visibility="Collapsed"
                                        Margin="0,6,0,0"
                                        Padding="14"
                                        Background="White"
                                        BorderBrush="#E1E7E3"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <WrapPanel>
                                        <CheckBox x:Name="FiltroSituacaoTG" Content="TG" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroSituacaoSubstituto" Content="Substituto" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroSituacaoApto" Content="Apto" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroSituacaoInapto" Content="Inapto" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroSituacaoDispensado" Content="Dispensado" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroSituacaoIndefinido" Content="Indefinido" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroTrabalha" Content="Trabalha" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroRecebeAuxilio" Content="Recebe auxilio governamental" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroEstuda" Content="Estuda" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroExperiencia" Content="Tem experiencia profissional" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroProblemaSaude" Content="Tem problema de saude" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroDesejaServirSim" Content="Deseja servir" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroDesejaServirNao" Content="Nao deseja servir" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="GradeConscritos"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionChanged="GradeConscritos_SelectionChanged"
                                  HeadersVisibility="Column"
                                  BorderThickness="1"
                                  BorderBrush="#DFE7E2"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F4F2"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFCFB"
                                  RowHeight="40">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F7F5" />
                                    <Setter Property="Foreground" Value="#123322" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#DFE7E2" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}"
                                                        Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome"
                                                    Width="1.6*"
                                                    Binding="{Binding Nome}" />
                                <DataGridTextColumn Header="CPF"
                                                    Width="1.1*"
                                                    Binding="{Binding CPF}" />
                                <DataGridTextColumn Header="RA"
                                                    Width="0.9*"
                                                    Binding="{Binding RA}" />
                                <DataGridTemplateColumn Header="Situação"
                                                        Width="1*"
                                                        SortMemberPath="Situacao">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,4"
                                                    CornerRadius="12"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E5E7EB" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="TG">
                                                                <Setter Property="Background" Value="#166534" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Substituto">
                                                                <Setter Property="Background" Value="#86EFAC" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Apto">
                                                                <Setter Property="Background" Value="#FACC15" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Inapto">
                                                                <Setter Property="Background" Value="#F97316" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Dispensado">
                                                                <Setter Property="Background" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Situacao}"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1F2937" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="TG">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Substituto">
                                                                    <Setter Property="Foreground" Value="#14532D" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Apto">
                                                                    <Setter Property="Foreground" Value="#713F12" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Inapto">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Dispensado">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

