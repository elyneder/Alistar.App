<Window x:Class="Alistar.App.TelaPainelControle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Painel de Controle"
        Height="760"
        Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Views/Assets/alistar_icone.ico">

    <Window.Resources>
        <!-- Estilos locais usados pela lista, filtros e botões compactos do painel. -->
        <Style x:Key="CaixaPesquisaListaStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="460" />
            <Setter Property="Height" Value="34" />
            <Setter Property="BorderBrush" Value="#D5DDD8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="CheckBoxFiltroStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="BotaoConsultaCompactoStyle" TargetType="Button" BasedOn="{StaticResource BotaoSecundarioStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>

        <Style x:Key="CartaoResumoSituacaoStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAF9" />
            <Setter Property="BorderBrush" Value="#E3EBE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>

        <Style x:Key="AbaPainelStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#63756E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="15,4" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="BordaAba"
                                Margin="0,0,10,0"
                                Background="#F3F7F5"
                                BorderBrush="#DFE7E2"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BordaAba" Property="Background" Value="#145C3B" />
                                <Setter TargetName="BordaAba" Property="BorderBrush" Value="#145C3B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BordaAba" Property="BorderBrush" Value="#145C3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Estrutura principal: menu lateral fixo e conteudo dinamico a direita. -->
    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B1E14"
                CornerRadius="0,24,24,0">
            <Grid Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,40"
                            HorizontalAlignment="Center">
                    <Image Source="./Assets/2-semfundo.png"
                        Width="177"
                        Height="133"
                        Stretch="UniformToFill"/>
                    <TextBlock Text="Sistema de Conscritos"
                               FontSize="12"
                               Foreground="#688077"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="BotaoTelaInicial"
                            Content=" 🏠︎ Tela Inicial"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarTelaInicialBotao_Click" />

                    <Button x:Name="BotaoListaConscritos"
                            Content=" 🔍︎ Consultar Lista"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarListaConscritosBotao_Click" />

                    <Button x:Name="BotaoSituacoes"
                            Content=" 📊 Situações"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarSituacoesBotao_Click" />

                    <Button x:Name="VerEntrevistadores"
                            Content=" 👥 Ver Entrevistadores"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="VerEntrevistadoresBotao_Click" />

                    <Button x:Name="BotaoLogsGerais"
                            Content=" 📋 Histórico de Atualizações"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarLogsGeraisBotao_Click" />

                    <Border Margin="0,30,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#163626">
                        <StackPanel>
                            <TextBlock Text="Total de Conscritos Cadastrados"
                                       Foreground="#8BA698"
                                       FontSize="12" />
                            <TextBlock x:Name="TextoQuantidadeConscritos"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="CadastrarEntrevistador"
                            Content=" 👤 Cadastrar Entrevistador"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Margin="0,0,0,12"
                            Click="AbrirCadastroUsuarioBotao_Click" />

                    <Button Content=" ➜ Sair do Sistema"
                        Style="{StaticResource BotaoPerigoTextoStyle}"
                        Click="SairSistemaBotao_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">
                <TextBlock Text="Painel de Controle"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#123322" />
                <TextBlock Text="Use o painel como hub e abra cada etapa em sua própria tela."
                           FontSize="15"
                           Foreground="#688077"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="VisaoInicial"
                              Visibility="Visible"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Fluxo de Etapas"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#123322"
                                   Margin="0,0,0,16" />

                        <UniformGrid Columns="3">
                            <Button x:Name="BotaoPrimeiraEtapa"
                                    Style="{StaticResource BotaoEtapaStyle}"
                                    Click="PrimeiraEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="01"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Cadastrar Conscrito"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Registro completo dos dados pessoais do conscrito"
                                               FontSize="12"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BotaoSegundaEtapa"
                                    Style="{StaticResource BotaoEtapaStyle}"
                                    Click="SegundaEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="02"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Exames Médicos"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Avaliação clínica e laudos de aptidão física"
                                               FontSize="12"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BotaoTerceiraEtapa"
                                    Style="{StaticResource BotaoEtapaStyle}"
                                    Click="TerceiraEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="03"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Entrevista Técnica"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Revisão e atualização da ficha da primeira etapa"
                                               FontSize="12"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BotaoQuartaEtapa"
                                    Style="{StaticResource BotaoEtapaStyle}"
                                    Click="QuartaEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="04"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Reavaliação Médica"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Reavaliação médica do conscrito"
                                               FontSize="12"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="BotaoQuintaEtapa"
                                    Style="{StaticResource BotaoEtapaStyle}"
                                    Click="QuintaEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="05"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Designação Final"
                                               FontWeight="Bold"
                                               FontSize="24"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Ranking final dos conscritos elegíveis para TG e substitutos"
                                               FontSize="10.8"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="VisaoListaConscritos"
                        Visibility="Collapsed"
                        Background="White"
                        CornerRadius="20"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,24">
                            <TextBlock FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#123322"
                                       Text="Lista de Candidatos" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="15"
                                       Foreground="#63756E"
                                       Text="Selecione um conscrito para abrir a Primeira Etapa em uma tela separada." />
                            <TextBlock x:Name="TextoResumoLista"
                                       Margin="0,8,0,0"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Text="0 conscritos encontrados." />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,0,0,20"
                                Padding="18"
                                Background="#F8FAF9"
                                BorderBrush="#E3EBE6"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,12">
                                    <TextBox x:Name="CaixaPesquisaConscrito"
                                             Style="{StaticResource CaixaPesquisaListaStyle}"
                                             KeyDown="CaixaPesquisaConscrito_KeyDown"
                                             ToolTip="Pesquise por nome, CPF ou RA" />

                                    <Button Width="94"
                                            Style="{StaticResource BotaoConsultaCompactoStyle}"
                                            Click="PesquisarConscritoBotao_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"
                                                  Stroke="#196743"
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  Margin="0,0,6,0" />
                                            <TextBlock Text="Pesquisar" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BotaoAlternarFiltros"
                                            Width="96"
                                            Style="{StaticResource BotaoConsultaCompactoStyle}"
                                            Click="AlternarFiltrosBotao_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas x:Name="IconeFiltros" Width="14" Height="14" Margin="0,0,6,0" Visibility="Visible">
                                                <Line X1="0" Y1="2" X2="14" Y2="2" Stroke="#196743" StrokeThickness="1.5"/>
                                                <Line X1="2" Y1="6" X2="12" Y2="6" Stroke="#196743" StrokeThickness="1.5"/>
                                                <Line X1="4" Y1="10" X2="10" Y2="10" Stroke="#196743" StrokeThickness="1.5"/>
                                            </Canvas>
                                            <Canvas x:Name="IconeOcultar" Width="14" Height="14" Margin="0,0,6,0" Visibility="Collapsed">
                                                <Ellipse Canvas.Left="2" Canvas.Top="4" Width="10" Height="6"
                                                         Stroke="#196743" StrokeThickness="1.5" Fill="Transparent"/>
                                                <Ellipse Canvas.Left="5" Canvas.Top="5.5" Width="4" Height="4"
                                                         Stroke="#196743" StrokeThickness="1" Fill="Transparent"/>
                                                <Line X1="1" Y1="13" X2="13" Y2="1" Stroke="#196743" StrokeThickness="1.5"/>
                                            </Canvas>
                                            <TextBlock x:Name="TextoBotaoFiltros" Text="Filtros"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Width="78"
                                            Style="{StaticResource BotaoConsultaCompactoStyle}"
                                            Click="LimparFiltrosBotao_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M6 18L18 6M6 6l12 12"
                                                  Stroke="#196743"
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  Margin="0,0,6,0" />
                                            <TextBlock Text="Limpar" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <Border x:Name="PainelFiltrosRapidos"
                                        Visibility="Collapsed"
                                        Margin="0,6,0,0"
                                        Padding="14"
                                        Background="White"
                                        BorderBrush="#E1E7E3"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Situação" FontWeight="SemiBold" Foreground="#123322" Margin="0,0,0,8" />
                                            <WrapPanel>
                                                <CheckBox x:Name="FiltroSituacaoTG" Content="TG" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroSituacaoSubstituto" Content="Substituto" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroSituacaoApto" Content="Apto" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroSituacaoInapto" Content="Inapto" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroSituacaoDispensado" Content="Dispensado" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroSituacaoRefratario" Content="Refratário" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroSituacaoIndefinido" Content="Indefinido" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                            <TextBlock Text="Perguntas pessoais" FontWeight="SemiBold" Foreground="#123322" Margin="0,0,0,8" />
                                            <WrapPanel>
                                                <CheckBox x:Name="FiltroTrabalha" Content="Trabalha" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroRecebeAuxilio" Content="Recebe auxílio governamental" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroEstuda" Content="Estuda" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroExperiencia" Content="Tem experiência profissional" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroProblemaSaude" Content="Tem problema de saúde" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroDesejaServirSim" Content="Deseja servir" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroDesejaServirNao" Content="Não deseja servir" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                                            <TextBlock Text="Andamento" FontWeight="SemiBold" Foreground="#123322" Margin="0,0,0,8" />
                                            <WrapPanel>
                                                <CheckBox x:Name="FiltroAndamentoEmAndamento" Content="Em andamento" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroAndamentoFinalizado" Content="Finalizado" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                                <CheckBox x:Name="FiltroAndamentoFaltoso" Content="Faltoso" Style="{StaticResource CheckBoxFiltroStyle}" Checked="FiltroRapido_Changed" Unchecked="FiltroRapido_Changed" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="GradeConscritos"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionChanged="GradeConscritos_SelectionChanged"
                                  HeadersVisibility="Column"
                                  BorderThickness="1"
                                  BorderBrush="#DFE7E2"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F4F2"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFCFB"
                                  RowHeight="40">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E3F5EA"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#123322"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E3F5EA"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#123322"/>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="#123322" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F8F5" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F5EA"/>
                                            <Setter Property="Foreground" Value="#123322"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F7F5" />
                                    <Setter Property="Foreground" Value="#123322" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#DFE7E2" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}"
                                                        Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome"
                                                    Width="1.6*"
                                                    Binding="{Binding Nome}" />
                                <DataGridTextColumn Header="CPF"
                                                    Width="1.1*"
                                                    Binding="{Binding CPF}" />
                                <DataGridTextColumn Header="RA"
                                                    Width="0.9*"
                                                    Binding="{Binding RA}" />
                                <DataGridTemplateColumn Header="Andamento"
                                                        Width="1.15*"
                                                        SortMemberPath="AndamentoProcesso">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="10"
                                                         Height="10"
                                                         Margin="0,0,8,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FACC15" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AndamentoProcesso}" Value="Finalizado">
                                                                    <Setter Property="Fill" Value="#16A34A" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AndamentoProcesso}" Value="Faltoso">
                                                                    <Setter Property="Fill" Value="#2563EB" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding AndamentoProcesso}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Situação"
                                                        Width="1*"
                                                        SortMemberPath="Situacao">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,4"
                                                    CornerRadius="12"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E5E7EB" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="TG">
                                                                <Setter Property="Background" Value="#166534" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Substituto">
                                                                <Setter Property="Background" Value="#86EFAC" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Apto">
                                                                <Setter Property="Background" Value="#FACC15" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Inapto">
                                                                <Setter Property="Background" Value="#F97316" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Dispensado">
                                                                <Setter Property="Background" Value="#DC2626" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Refratário">
                                                                <Setter Property="Background" Value="#7C2D12" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Situacao}"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1F2937" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="TG">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Substituto">
                                                                    <Setter Property="Foreground" Value="#14532D" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Apto">
                                                                    <Setter Property="Foreground" Value="#713F12" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Inapto">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Dispensado">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Refratário">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border x:Name="VisaoSituacoes"
                        Visibility="Collapsed"
                        Background="White"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="Situações dos Conscritos"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#123322" />
                            <TextBlock x:Name="TextoResumoSituacoes"
                                       Text="Resumo por situação cadastrada."
                                       FontSize="15"
                                       Foreground="#63756E"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <TabControl Grid.Row="1"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    ItemContainerStyle="{StaticResource AbaPainelStyle}">
                            <TabItem Header="Resumo">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                                    <ItemsControl x:Name="ListaResumoSituacoes">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CartaoResumoSituacaoStyle}">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="10" Height="10" Fill="{Binding Cor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Situacao}" Foreground="#123322" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Quantidade}" FontSize="30" FontWeight="Bold" Foreground="#111111" Margin="0,8,0,0" />
                                                        <TextBlock Text="{Binding PercentualTexto}" Foreground="#63756E" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Gráfico">
                                <ScrollViewer Margin="0,22,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Border Padding="24" Background="#F8FAF9" BorderBrush="#E3EBE6" BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Distribuição por situação"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="#123322"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Filtrar situação"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#123322"
                                                           Margin="0,0,0,6" />
                                                <ComboBox x:Name="ComboFiltroSituacaoResumo"
                                                          Height="34"
                                                          HorizontalContentAlignment="Left"
                                                          VerticalContentAlignment="Center"
                                                          SelectionChanged="ComboFiltroSituacaoResumo_SelectionChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="1"
                                                MinHeight="400"
                                                Background="White"
                                                BorderBrush="#E3EBE6"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="20,18,20,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="1" />
                                                </Grid.RowDefinitions>

                                                <Line Grid.Row="1"
                                                      X1="0"
                                                      X2="10000"
                                                      Y1="0"
                                                      Y2="0"
                                                      Stroke="#DDE7E2"
                                                      StrokeThickness="1" />

                                                <ItemsControl x:Name="GraficoSituacoes"
                                                              VerticalAlignment="Stretch">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="8,0"
                                                                  MinHeight="340">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding Quantidade}"
                                                                               FontWeight="Bold"
                                                                               FontSize="18"
                                                                               Foreground="#111111"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,0,0,8" />
                                                                    <Border Width="62"
                                                                            Height="{Binding AlturaColuna}"
                                                                            Background="{Binding Cor}"
                                                                            CornerRadius="9,9,0,0" />
                                                                    <TextBlock Text="{Binding PercentualTexto}"
                                                                               Foreground="#63756E"
                                                                               FontSize="12"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,8,0,0" />
                                                                </StackPanel>

                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding Situacao}"
                                                                           Foreground="#334155"
                                                                           FontWeight="SemiBold"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,12,0,0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </Border>
                <Border x:Name="VisaoEntrevistadores"
                        Visibility="Collapsed"
                        Background="White"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Entrevistadores"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#123322" />
                            <TextBlock x:Name="TextoResumoEntrevistadoresPainel"
                                       Text="Usuários cadastrados pelo administrador."
                                       FontSize="15"
                                       Foreground="#63756E"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <DataGrid x:Name="GradeEntrevistadoresPainel"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  BorderThickness="1"
                                  BorderBrush="#DFE7E2"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F4F2"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFCFB"
                                  RowHeight="40">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E3F5EA"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#123322"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E3F5EA"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#123322"/>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="#123322" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F3F8F5" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F5EA"/>
                                            <Setter Property="Foreground" Value="#123322"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F7F5" />
                                    <Setter Property="Foreground" Value="#123322" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#DFE7E2" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="Foreground" Value="#123322" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F5EA"/>
                                            <Setter Property="Foreground" Value="#123322"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style x:Key="BotaoAcaoTabelaStyle" TargetType="Button" BasedOn="{StaticResource BotaoIconeStyle}">
                                    <Setter Property="Width" Value="34" />
                                    <Setter Property="Height" Value="34" />
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="Background" Value="#EAF1ED" />
                                    <Setter Property="Foreground" Value="#145C3B" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="#D5DDD8" />
                                </Style>
                                <Style x:Key="BotaoAcaoPerigoTabelaStyle" TargetType="Button" BasedOn="{StaticResource BotaoAcaoTabelaStyle}">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="#C0392B" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderBrush" Value="#C0392B" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*" />
                                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="2*" />
                                <DataGridTemplateColumn Header="Ações" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button Content="&#xE9D9;"
                                                        ToolTip="Ver detalhes"
                                                        Style="{StaticResource BotaoAcaoTabelaStyle}"
                                                        Click="DetalhesEntrevistadorBotao_Click" />
                                                <Button Content="&#xE70F;"
                                                        ToolTip="Editar"
                                                        Style="{StaticResource BotaoAcaoTabelaStyle}"
                                                        Click="EditarEntrevistadorBotao_Click" />
                                                <Button Content="&#xE74D;"
                                                        ToolTip="Excluir"
                                                        Style="{StaticResource BotaoAcaoPerigoTabelaStyle}"
                                                        Click="ExcluirEntrevistadorBotao_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border x:Name="VisaoLogsGerais"
                        Visibility="Collapsed"
                        Background="White"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Histórico de Atualizações"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#123322" />
                            <TextBlock Text="Histórico de acessos e alterações realizadas no sistema."
                                       FontSize="15"
                                       Foreground="#63756E"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <DataGrid x:Name="GradeLogsGerais"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  BorderThickness="1"
                                  BorderBrush="#DFE7E2"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F4F2"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFCFB"
                                  RowHeight="40"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F7F5" />
                                    <Setter Property="Foreground" Value="#123322" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#DFE7E2" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" Width="140" />
                                <DataGridTextColumn Header="Usuário" Binding="{Binding UsuarioNome}" Width="170" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoUsuario}" Width="140" />
                                <DataGridTemplateColumn Header="Ação" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Acao}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Acao}" Value="Alteracao">
                                                                <Setter Property="Text" Value="Alteração" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Entidade" Binding="{Binding Entidade}" Width="210" />
                                <DataGridTextColumn Header="Campo" Binding="{Binding Campo}" Width="180" />
                                <DataGridTextColumn Header="Antes" Binding="{Binding ValorAnterior}" Width="180" />
                                <DataGridTextColumn Header="Depois" Binding="{Binding ValorNovo}" Width="180" />
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="280" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
