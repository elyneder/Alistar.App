                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <ComboBox x:Name="ComboDesejaServir" Style="{StaticResource CampoComboDocumentoStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Não" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
