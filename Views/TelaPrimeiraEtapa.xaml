                                    <StackPanel Orientation="Horizontal">
                                        <Canvas x:Name="IconeAvancarBotaoSalvar"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center">
                                            <Line X1="2" Y1="7" X2="12" Y2="7" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="8" Y1="3" X2="12" Y2="7" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="8" Y1="11" X2="12" Y2="7" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                        <Canvas x:Name="IconeSalvarBotaoSalvar" Width="14" Height="14" Margin="0,0,6,0" Visibility="Collapsed">
                                            <Polyline Points="2,7 6,11 12,3"
