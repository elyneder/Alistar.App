                                    <StackPanel Orientation="Horizontal">
                                        <Canvas Width="14" Height="14" Margin="0,0,6,0">
                                            <Path Data="M3,10 L9,4 L12,7 L6,13 Z"
                                                  Stroke="#196743"
                                                  StrokeThickness="1.4"
                                                  Fill="Transparent"
                                                  StrokeLineJoin="Round" />
                                            <Line X1="6" Y1="13" X2="12" Y2="13" Stroke="#196743" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                                        </Canvas>
                                        <TextBlock x:Name="TextoBotaoLimpar" Text="Limpar"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BotaoExcluirConscrito"
                                    Width="120"
                                    Margin="16,8,0,0"
                                    Style="{StaticResource BotaoSecundarioStyle}"
                                    Click="ExcluirConscritoBotao_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Canvas Width="14" Height="14" Margin="0,0,6,0">
                                            <Line X1="2" Y1="4" X2="12" Y2="4" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="5" Y1="4" X2="5" Y2="2" Stroke="#196743" StrokeThickness="1.5"/>
                                            <Line X1="9" Y1="4" X2="9" Y2="2" Stroke="#196743" StrokeThickness="1.5"/>
                                            <Rectangle Canvas.Left="3" Canvas.Top="4" Width="8" Height="8"
                                            Stroke="#196743" StrokeThickness="1.5" Fill="Transparent"/>
                                        </Canvas>
                                        <TextBlock Text="Excluir"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BotaoPdfCadastro"
                                    Width="140"
                                    Margin="16,8,0,0"
                                    Style="{StaticResource BotaoSecundarioStyle}"
                                    Click="GerarPdfCadastroBotao_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Canvas Width="14" Height="14" Margin="0,0,6,0">
                                            <Rectangle Canvas.Left="3" Canvas.Top="1" Width="8" Height="12" Stroke="#196743" StrokeThickness="1.4" Fill="Transparent"/>
                                            <Line X1="5" Y1="5" X2="9" Y2="5" Stroke="#196743" StrokeThickness="1.2"/>
                                            <Line X1="5" Y1="8" X2="9" Y2="8" Stroke="#196743" StrokeThickness="1.2"/>
                                        </Canvas>
                                        <TextBlock Text="PDF Cadastro"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BotaoPdfMedico"
                                    Width="125"
                                    Margin="16,8,0,0"
                                    Style="{StaticResource BotaoSecundarioStyle}"
                                    Click="GerarPdfMedicoBotao_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Canvas Width="14" Height="14" Margin="0,0,6,0">
                                            <Rectangle Canvas.Left="3" Canvas.Top="1" Width="8" Height="12" Stroke="#196743" StrokeThickness="1.4" Fill="Transparent"/>
                                            <Line X1="7" Y1="4" X2="7" Y2="10" Stroke="#196743" StrokeThickness="1.3"/>
                                            <Line X1="4" Y1="7" X2="10" Y2="7" Stroke="#196743" StrokeThickness="1.3"/>
                                        </Canvas>
                                        <TextBlock Text="PDF Médico"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="VisaoListaConscritos"
                        Visibility="Collapsed"
                        Background="White"
                        CornerRadius="20"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        Padding="32">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,24">
                            <TextBlock FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#123322"
                                       Text="Lista de Candidatos" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="15"
                                       Foreground="#63756E"
                                       Text="Todos os conscritos cadastrados no sistema." />
                            <TextBlock x:Name="TextoResumoLista"
                                       Margin="0,8,0,0"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Text="0 conscritos encontrados." />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,0,0,20"
                                Padding="18"
                                Background="#F8FAF9"
                                BorderBrush="#E3EBE6"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,12">
                                    <TextBox x:Name="CaixaPesquisaConscrito"
                                             Style="{StaticResource CaixaPesquisaListaStyle}"
                                             KeyDown="CaixaPesquisaConscrito_KeyDown"
                                             ToolTip="Pesquise por nome, CPF ou RA" />

                                    <Button Width="94"
                                       Style="{StaticResource BotaoConsultaCompactoStyle}"
                                        Click="PesquisarConscritoBotao_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"
                                                Stroke="#196743" StrokeThickness="1.5" Fill="Transparent"
                                                Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                            <TextBlock Text="Pesquisar"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BotaoAlternarFiltros"
                                        Width="96"
                                        Style="{StaticResource BotaoConsultaCompactoStyle}"
                                        Click="AlternarFiltrosBotao_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas x:Name="IconeFiltros" Width="14" Height="14" Margin="0,0,6,0" Visibility="Visible">
                                                <Line X1="0" Y1="2" X2="14" Y2="2" Stroke="#196743" StrokeThickness="1.5"/>
                                                <Line X1="2" Y1="6" X2="12" Y2="6" Stroke="#196743" StrokeThickness="1.5"/>
                                                <Line X1="4" Y1="10" X2="10" Y2="10" Stroke="#196743" StrokeThickness="1.5"/>
                                            </Canvas>
                                            <Canvas x:Name="IconeOcultar" Width="14" Height="14" Margin="0,0,6,0" Visibility="Collapsed">
                                                <Ellipse Canvas.Left="2" Canvas.Top="4" Width="10" Height="6"
                                                    Stroke="#196743" StrokeThickness="1.5" Fill="Transparent"/>
                                                <Ellipse Canvas.Left="5" Canvas.Top="5.5" Width="4" Height="4"
                                                    Stroke="#196743" StrokeThickness="1" Fill="Transparent"/>
                                                <Line X1="1" Y1="13" X2="13" Y2="1" Stroke="#196743" StrokeThickness="1.5"/>
                                            </Canvas>
                                            <TextBlock x:Name="TextoBotaoFiltros" Text="Filtros"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Width="78"
                                        Style="{StaticResource BotaoConsultaCompactoStyle}"
                                        Click="LimparFiltrosBotao_Click">           
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M6 18L18 6M6 6l12 12"
                                                Stroke="#196743" StrokeThickness="1.5" Fill="Transparent"
                                                Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>           
                                            <TextBlock Text="Limpar"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <Border x:Name="PainelFiltrosRapidos"
                                        Visibility="Collapsed"
                                        Margin="0,6,0,0"
                                        Padding="14"
                                        Background="White"
                                        BorderBrush="#E1E7E3"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <WrapPanel>
                                        <CheckBox x:Name="FiltroSituacaoTG"
                                                  Content="TG"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroSituacaoSubstituto"
                                                  Content="Substituto"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroSituacaoApto"
                                                  Content="Apto"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroSituacaoInapto"
                                                  Content="Inapto"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroSituacaoDispensado"
                                                  Content="Dispensado"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroSituacaoIndefinido"
                                                  Content="Indefinido"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroTrabalha"
                                                  Content="Trabalha"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroRecebeAuxilio"
                                                  Content="Recebe auxílio governamental"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroEstuda"
                                                  Content="Estuda"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroExperiencia"
                                                  Content="Tem experiência profissional"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroProblemaSaude"
                                                  Content="Tem problema de saúde"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroDesejaServirSim"
                                                  Content="Deseja servir"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                        <CheckBox x:Name="FiltroDesejaServirNao"
                                                  Content="Não deseja servir"
                                                  Style="{StaticResource CheckBoxFiltroStyle}"
                                                  Checked="FiltroRapido_Changed"
                                                  Unchecked="FiltroRapido_Changed" />
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="GradeConscritos"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionChanged="GradeConscritos_SelectionChanged"
                                  HeadersVisibility="Column"
                                  BorderThickness="1"
                                  BorderBrush="#DFE7E2"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F4F2"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFCFB"
                                  RowHeight="40">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F7F5" />
                                    <Setter Property="Foreground" Value="#123322" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#DFE7E2" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}"
                                                        Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome"
                                                    Width="1.6*"
                                                    Binding="{Binding Nome}" />
                                <DataGridTextColumn Header="CPF"
                                                    Width="1.1*"
                                                    Binding="{Binding CPF}" />
                                <DataGridTextColumn Header="RA"
                                                    Width="0.9*"
                                                    Binding="{Binding RA}" />
                                <DataGridTemplateColumn Header="Situação"
                                                        Width="1*"
                                                        SortMemberPath="Situacao">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,4"
                                                    CornerRadius="12"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E5E7EB" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="TG">
                                                                <Setter Property="Background" Value="#166534" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Substituto">
                                                                <Setter Property="Background" Value="#86EFAC" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Apto">
                                                                <Setter Property="Background" Value="#FACC15" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Inapto">
                                                                <Setter Property="Background" Value="#F97316" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Situacao}" Value="Dispensado">
                                                                <Setter Property="Background" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Situacao}"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1F2937" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="TG">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Substituto">
                                                                    <Setter Property="Foreground" Value="#14532D" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Apto">
                                                                    <Setter Property="Foreground" Value="#713F12" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Inapto">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Situacao}" Value="Dispensado">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

