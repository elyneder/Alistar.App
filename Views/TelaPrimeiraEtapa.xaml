<Window x:Class="Alistar.App.TelaPrimeiraEtapa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Primeira Etapa"
        Height="760"
        Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Views/Assets/alistar_icone.ico">

    <Window.Resources>
        <!-- Estilos do formulario em formato de ficha e dos controles do wizard. -->
        <Style x:Key="TituloSecaoPapelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#111111" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="TituloBlocoPapelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DescricaoBlocoPapelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A5F66" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,22" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RotuloCampoDocumentoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PainelCampoDocumentoStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,26,18" />
        </Style>

        <Style x:Key="PainelCampoVerticalStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="LinhaCamposAgrupadosStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="LinhaCampoDocumentoStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#111111" />
            <Setter Property="BorderThickness" Value="0,0,0,1.2" />
            <Setter Property="Padding" Value="2,2,2,3" />
        </Style>

        <Style x:Key="CampoTextoDocumentoStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#111111" />
        </Style>

        <Style x:Key="CampoTextoMultilinhaDocumentoStyle" TargetType="TextBox" BasedOn="{StaticResource CampoTextoDocumentoStyle}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <Style x:Key="CampoComboDocumentoStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style x:Key="CaixaSecaoDocumentoStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CaixaPesquisaListaStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="460" />
            <Setter Property="Height" Value="34" />
            <Setter Property="BorderBrush" Value="#D5DDD8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="CheckBoxFiltroStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BotaoConsultaCompactoStyle" TargetType="Button" BasedOn="{StaticResource BotaoSecundarioStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>

        <Style x:Key="CartaoEtapaWizardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E1DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="NumeroEtapaWizardStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#123322" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="TituloEtapaWizardStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#123322" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="DescricaoEtapaWizardStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F7168" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <!-- Tela com menu lateral, painel inicial, formulario da primeira etapa e lista de conscritos. -->
    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B1E14"
                CornerRadius="0,24,24,0">
            <Grid Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                    Margin="0,0,0,40"
                    HorizontalAlignment="Center">
                    <Image Source="./Assets/2-semfundo.png"
                        Width="177"
                        Height="133"
                        Stretch="UniformToFill"/>
                    <TextBlock Text="Sistema de Conscritos"
                        FontSize="12"
                        Foreground="#688077"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="BotaoTelaInicial"
                            Content=" 🏠︎ Tela Inicial"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarTelaInicialBotao_Click" />

                    <Button x:Name="BotaoListaConscritos"
                            Content=" 🔍︎ Consultar Lista"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarListaConscritosBotao_Click" />

                    <Button x:Name="VerEntrevistadores" Content=" 👥 Ver Entrevistadores"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="VerEntrevistadoresBotao_Click" />

                    <Border Margin="0,30,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#163626">
                        <StackPanel>
                            <TextBlock Text="Total de Conscritos Cadastrados"
                                       Foreground="#8BA698"
                                       FontSize="12" />
                            <TextBlock x:Name="TextoQuantidadeConscritos"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="CadastrarEntrevistador" Content=" 👤 Cadastrar Entrevistador"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Margin="0,0,0,12"
                            Click="AbrirCadastroUsuarioBotao_Click" />

                    <Button Content=" ➜] Sair do Sistema"
                            Style="{StaticResource BotaoPerigoTextoStyle}"
                            Click="SairSistemaBotao_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">
                <Button HorizontalAlignment="Left"
                    Margin="0,0,0,12"
                    Padding="12,8"
                    Style="{StaticResource BotaoSecundarioStyle}"
                    Click="MostrarTelaInicialBotao_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="  🡸  Voltar     " VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TextoTituloCabecalho"
           Text="Primeira Etapa"
           FontSize="32"
           FontWeight="Bold"
           Foreground="#123322" />

                <TextBlock x:Name="TextoDescricaoCabecalho"
           Text="Registro completo de dados pessoais e perfil"
           FontSize="15"
           Foreground="#688077"
           Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="VisaoInicial"
                              Visibility="Visible"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Fluxo de Etapas"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#123322"
                                   Margin="0,0,0,16" />

                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource BotaoEtapaStyle}"
                                    Click="PrimeiraEtapaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="01"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Primeira Etapa"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Cadastrar conscrito"
                                               FontSize="13"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoEtapaStyle}"
                                    Click="EtapaFuturaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="02"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Segunda Etapa"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Exames e avaliação"
                                               FontSize="13"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoEtapaStyle}"
                                    Click="EtapaFuturaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="03"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Terceira Etapa"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Testes de aptidão"
                                               FontSize="13"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoEtapaStyle}"
                                    Click="EtapaFuturaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="04"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Quarta Etapa"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Entrevista técnica"
                                               FontSize="13"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource BotaoEtapaStyle}"
                                    Click="EtapaFuturaBotao_Click">
                                <StackPanel>
                                    <TextBlock Text="05"
                                               FontSize="32"
                                               FontWeight="Black"
                                               Foreground="#123322" />
                                    <TextBlock Text="Quinta Etapa"
                                               FontWeight="Bold"
                                               FontSize="18"
                                               Foreground="#123322"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Designação final"
                                               FontSize="13"
                                               Foreground="#688077" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="VisaoCadastroConscrito"
                        Visibility="Collapsed"
                        Background="#EEF2EF"
                        CornerRadius="20"
                        BorderBrush="#DFE7E2"
                        BorderThickness="1"
                        Padding="22">
                    <ScrollViewer x:Name="ScrollFormularioCadastro"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PainelFormularioCadastro"
                                    MaxWidth="1080"
                                    HorizontalAlignment="Center">
                            <TextBlock x:Name="TextoTituloFormulario"
                                       Text="Primeira Etapa de Seleção"
                                       Style="{StaticResource TituloBlocoPapelStyle}" 
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="TextoDescricaoFormulario"
                                       Text="Preencha a ficha completa do conscrito. As respostas serão salvas no sistema para consulta posterior."
                                       Style="{StaticResource DescricaoBlocoPapelStyle}" 
                                       TextAlignment="Center"/>

                            <Border Background="#F8FBF9"
                                    BorderBrush="#DDE7E1"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <UniformGrid Columns="4"
                                                 Margin="0,0,0,16">
                                        <Border x:Name="IndicadorEtapaBasica" Style="{StaticResource CartaoEtapaWizardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="01" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                                <TextBlock Text="Informações básicas" Style="{StaticResource TituloEtapaWizardStyle}" />
                                                <TextBlock Text="Dados iniciais obrigatórios" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="IndicadorEtapaQuestionario" Style="{StaticResource CartaoEtapaWizardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="02" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                                <TextBlock Text="Blocos A até J" Style="{StaticResource TituloEtapaWizardStyle}" />
                                                <TextBlock Text="Questionário complementar" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="IndicadorEtapaManifestacao" Style="{StaticResource CartaoEtapaWizardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="03" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                                <TextBlock Text="Bloco K" Style="{StaticResource TituloEtapaWizardStyle}" />
                                                <TextBlock Text="Manifestação do desejo de servir" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="IndicadorEtapaConfirmacao" Style="{StaticResource CartaoEtapaWizardStyle}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="04" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                                <TextBlock Text="Confirmação final" Style="{StaticResource TituloEtapaWizardStyle}" />
                                                <TextBlock Text="Formulário completo para revisão" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <TextBlock x:Name="TextoEtapaWizard"
                                               Text="Etapa 1 de 4 · Informações básicas"
                                               Foreground="#123322"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center" />
                                    <TextBlock x:Name="TextoResumoEtapaWizard"
                                               Margin="0,6,0,0"
                                               Text="Preencha os dados essenciais do conscrito para iniciar o cadastro."
                                               Foreground="#63756E"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="SecaoInformacoesBasicas" Style="{StaticResource CaixaSecaoDocumentoStyle}">
                                <StackPanel>
                                    <TextBlock Text="INFORMAÇÕES BÁSICAS PARA SELEÇÃO"
                                               Style="{StaticResource TituloSecaoPapelStyle}" />

                                    <Grid Style="{StaticResource LinhaCamposAgrupadosStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                            <TextBlock Text="Nome:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                            <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                                <TextBox x:Name="CaixaTextoNomeConscrito"
                                                         TextChanged="CampoComMascara_TextChanged"
                                                         Style="{StaticResource CampoTextoDocumentoStyle}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="RA:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                            <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                                <TextBox x:Name="CaixaTextoRA"
                                                         MaxLength="16"
                                                         TextChanged="CampoComMascara_TextChanged"
                                                         Style="{StaticResource CampoTextoDocumentoStyle}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Style="{StaticResource PainelCampoVerticalStyle}">
                                        <TextBlock Text="CPF:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                                <TextBox x:Name="CaixaTextoCPF"
                                                         MaxLength="14"
                                                         TextChanged="CampoComMascara_TextChanged"
                                                         Style="{StaticResource CampoTextoDocumentoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PainelCampoVerticalStyle}">
                                        <TextBlock Text="Nome da mãe:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <TextBox x:Name="CaixaTextoNomeMae"
                                                     TextChanged="CampoComMascara_TextChanged"
                                                     Style="{StaticResource CampoTextoDocumentoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PainelCampoVerticalStyle}">
                                        <TextBlock Text="Data de nascimento:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <TextBox x:Name="CaixaTextoDataNascimento"
                                                     MaxLength="10"
                                                     TextChanged="CampoComMascara_TextChanged"
                                                     ToolTip="Exemplo: 15/04/2006"
                                                     Style="{StaticResource CampoTextoDocumentoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PainelCampoVerticalStyle}">
                                        <TextBlock Text="País de residência:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <TextBox x:Name="CaixaTextoPaisResidencia"
                                                     TextChanged="CampoComMascara_TextChanged"
                                                     Style="{StaticResource CampoTextoDocumentoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <Grid Style="{StaticResource LinhaCamposAgrupadosStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                            <TextBlock Text="Município de residência:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                            <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                                <TextBox x:Name="CaixaTextoMunicipioResidencia"
                                                         TextChanged="CampoComMascara_TextChanged"
                                                         Style="{StaticResource CampoTextoDocumentoStyle}"
                                                         />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Zona de residência:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                            <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                                <ComboBox x:Name="ComboZonaResidencia" Style="{StaticResource CampoComboDocumentoStyle}">
                                                    <ComboBoxItem Content="Selecione" />
                                                    <ComboBoxItem Content="Urbana" />
                                                    <ComboBoxItem Content="Rural" />
                                                </ComboBox>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Style="{StaticResource PainelCampoVerticalStyle}">
                                        <TextBlock Text="Situação:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <ComboBox x:Name="ComboSituacaoConscrito" Style="{StaticResource CampoComboDocumentoStyle}">
                                                <ComboBoxItem Content="Indefinido" />
                                                <ComboBoxItem Content="TG" />
                                                <ComboBoxItem Content="Substituto" />
                                                <ComboBoxItem Content="Apto" />
                                                <ComboBoxItem Content="Inapto" />
                                                <ComboBoxItem Content="Dispensado" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="PainelSecoesQuestionario">
                                <Border x:Name="SecaoBlocoA" Style="{StaticResource CaixaSecaoDocumentoStyle}">
                                    <StackPanel>
                                        <TextBlock Text="A. VIDA PESSOAL"
                                               Style="{StaticResource TituloSecaoPapelStyle}" />

                                    <StackPanel Style="{StaticResource PainelCampoVerticalStyle}">
                                        <TextBlock Text="1. Endereço:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <TextBox x:Name="CaixaTextoEndereco" Style="{StaticResource CampoTextoDocumentoStyle}" />
                                        </Border>
                                    </StackPanel>

                                        <Grid Style="{StaticResource LinhaCamposAgrupadosStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                                <TextBlock Text="2. Bairro:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                                <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                                    <TextBox x:Name="CaixaTextoBairro" Style="{StaticResource CampoTextoDocumentoStyle}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                                <TextBlock Text="CEP:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                                <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                                    <TextBox x:Name="CaixaTextoCEP"
                                                         MaxLength="9"
                                                         TextChanged="CampoComMascara_TextChanged"
                                                         Style="{StaticResource CampoTextoDocumentoStyle}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Telefone:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                                <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                                    <TextBox x:Name="CaixaTextoTelefone"
                                                         MaxLength="15"
                                                         TextChanged="CampoComMascara_TextChanged"
                                                         Style="{StaticResource CampoTextoDocumentoStyle}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Style="{StaticResource PainelCampoVerticalStyle}">
                                        <TextBlock Text="3. E-mail:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <TextBox x:Name="CaixaTextoEmail"
                                                     TextChanged="CampoComMascara_TextChanged"
                                                     Style="{StaticResource CampoTextoDocumentoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PainelCampoVerticalStyle}">
                                        <TextBlock Text="4. Ocupação:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoDocumentoStyle}">
                                            <TextBox x:Name="CaixaTextoOcupacao" Style="{StaticResource CampoTextoDocumentoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PainelCampoVerticalStyle}">
                                        <TextBlock Text="5. Mora com:" Style="{StaticResource RotuloCampoDocumentoStyle}" />
