<Window x:Class="Alistar.App.TelaQuartaEtapa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Quarta Etapa"
        Height="520"
        Width="860"
        WindowStartupLocation="CenterOwner">
    <!-- Estrutura inicial da quarta etapa, reservada para entrevista tecnica. -->
    <Grid Background="#F4F7F6">
        <Border Margin="24"
                Padding="28"
                Background="White"
                CornerRadius="18"
                BorderBrush="#DFE7E2"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Quarta Etapa"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#123322" />
                    <TextBlock Text="Tela dedicada a entrevista tecnica."
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#5A5F66" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,28,0,28"
                        Padding="22"
                        Background="#EEF2EF"
                        CornerRadius="14">
                    <TextBlock Text="A quarta etapa agora tem uma janela propria, pronta para receber campos e regras especificas."
                               TextWrapping="Wrap"
                               Foreground="#4B5563" />
                </Border>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="120"
                            Style="{StaticResource BotaoSecundarioStyle}"
                            Click="FecharBotao_Click"
                            Content="Fechar" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
