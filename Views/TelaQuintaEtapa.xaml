<Window x:Class="Alistar.App.TelaQuintaEtapa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Quinta Etapa"
        Height="760"
        Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Views/Assets/alistar_icone.ico">
    <Window.Resources>
        <Style x:Key="ResumoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE7E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <Style x:Key="RotuloResumoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#688077" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ValorResumoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#123322" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B1E14"
                CornerRadius="0,24,24,0">
            <Grid Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,40"
                            HorizontalAlignment="Center">
                    <Image Source="/Views/Assets/2-semfundo.png"
                           Width="177"
                           Height="133"
                           Stretch="UniformToFill"/>
                    <TextBlock Text="Sistema de Conscritos"
                               FontSize="12"
                               Foreground="#688077"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content=" 🏠︎ Tela Inicial"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarTelaInicialBotao_Click" />

                    <Border Margin="0,30,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#163626">
                        <StackPanel>
                            <TextBlock Text="Elegíveis para ranking"
                                       Foreground="#8BA698"
                                       FontSize="12" />
                            <TextBlock x:Name="TextoTotalElegiveisLateral"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content=" ➜ Sair do Sistema"
                            Style="{StaticResource BotaoPerigoTextoStyle}"
                            Click="SairSistemaBotao_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,22">
                <Button HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Style="{StaticResource BotaoSecundarioStyle}"
                        Click="MostrarTelaInicialBotao_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="  🡸  Voltar     "/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Quinta Etapa"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#123322" />
                <TextBlock Text="Designação final: entram apenas TG, Substituto e Refratário; ajuste cada conscrito para TG, Substituto ou Dispensado."
                           FontSize="15"
                           Foreground="#688077"
                           Margin="0,4,0,0" />
            </StackPanel>

            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,0,0,20">
                <Border Style="{StaticResource ResumoCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="TextoRotuloTopClassificados" Text="TOP 50" Style="{StaticResource RotuloResumoStyle}" />
                        <TextBlock x:Name="TextoTotalTop50" Text="0" Style="{StaticResource ValorResumoStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ResumoCardStyle}">
                    <StackPanel>
                        <TextBlock Text="SUBSTITUTOS" Style="{StaticResource RotuloResumoStyle}" />
                        <TextBlock x:Name="TextoTotalSubstitutos" Text="0" Style="{StaticResource ValorResumoStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ResumoCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ELEGÍVEIS" Style="{StaticResource RotuloResumoStyle}" />
                        <TextBlock x:Name="TextoTotalElegiveis" Text="0" Style="{StaticResource ValorResumoStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ResumoCardStyle}">
                    <StackPanel>
                        <TextBlock Text="FORA DO RANKING" Style="{StaticResource RotuloResumoStyle}" />
                        <TextBlock x:Name="TextoTotalExcluidos" Text="0" Style="{StaticResource ValorResumoStyle}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#DFE7E2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                <DataGrid x:Name="GradeRanking"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#F0F4F2"
                RowBackground="White"
                AlternatingRowBackground="#FAFCFB"
                RowHeight="40"
                BorderThickness="1"
                BorderBrush="#DFE7E2">

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E3F5EA"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#123322"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E3F5EA"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#123322"/>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F7F5" />
                            <Setter Property="Foreground" Value="#123322" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#DFE7E2" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E3F5EA"/>
                                    <Setter Property="Foreground" Value="#123322"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Posicao}" Width="70" />
                        <DataGridTextColumn Header="Classificação" Binding="{Binding Classificacao}" Width="1*" />
                        <DataGridTextColumn Header="RA" Binding="{Binding RA}" Width="1.2*" />
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*" />
                        <DataGridTextColumn Header="Pontuação" Binding="{Binding Pontuacao}" Width="1*" />

                        <DataGridTemplateColumn Header="Situação"
                        Width="1*"
                        SortMemberPath="Situacao">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="10,4"
                    CornerRadius="12"
                    HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E5E7EB" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Situacao}" Value="TG">
                                                        <Setter Property="Background" Value="#166534" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Situacao}" Value="Substituto">
                                                        <Setter Property="Background" Value="#86EFAC" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Situacao}" Value="Apto">
                                                        <Setter Property="Background" Value="#FACC15" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Situacao}" Value="Inapto">
                                                        <Setter Property="Background" Value="#F97316" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Situacao}" Value="Dispensado">
                                                        <Setter Property="Background" Value="#DC2626" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Situacao}" Value="Refratário">
                                                        <Setter Property="Background" Value="#7C2D12" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Situacao}"
                           FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1F2937" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Situacao}" Value="TG">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Situacao}" Value="Substituto">
                                                            <Setter Property="Foreground" Value="#14532D" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Situacao}" Value="Apto">
                                                            <Setter Property="Foreground" Value="#713F12" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Situacao}" Value="Inapto">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Situacao}" Value="Dispensado">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Situacao}" Value="Refratário">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Editar"
                                                Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="34"
                                            Height="28"
                                            Content="✎"
                                            Style="{StaticResource BotaoSecundarioStyle}"
                                            Click="AbrirMenuSituacao_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="TG" Click="AlterarSituacaoTG_Click" />
                                                <MenuItem Header="Substituto" Click="AlterarSituacaoSubstituto_Click" />
                                                <MenuItem Header="Dispensado" Click="AlterarSituacaoDispensado_Click" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock x:Name="TextoFeedbackRanking"
                       Grid.Row="3"
                       Margin="0,12,0,0"
                       Foreground="#63756E"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
