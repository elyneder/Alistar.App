<Window x:Class="Alistar.App.TelaRecuperacaoSenha"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Recuperar senha"
        Height="560"
        Width="520"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Icon="/Views/Assets/alistar_icone.ico">

    <Grid Background="#0F291D">
        <Viewbox Stretch="Uniform"
                 MaxWidth="560"
                 MaxHeight="560">
            <Border Background="#F8FAF9"
                    CornerRadius="18"
                    Padding="34">
                <StackPanel Width="400">
                <Border Width="56"
                        Height="56"
                        CornerRadius="28"
                        Background="#EAF1ED"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <Path Fill="#145C3B"
                          Width="25"
                          Height="25"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M12 1.8 3 5.8v5.8c0 5.2 3.8 10.1 9 11.4 5.2-1.3 9-6.2 9-11.4V5.8l-9-4zm3.8 8.2-4.6 4.6-2.3-2.3-1.4 1.4 3.7 3.7 6-6-1.4-1.4z" />
                </Border>

                <TextBlock Text="Recuperar senha"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="#1F2D26"
                           TextAlignment="Center"
                           Margin="0,0,0,8" />

                <TextBlock Text="Informe seu e-mail para receber o token de recuperacao e depois valide o codigo para continuar."
                           FontSize="13"
                           Foreground="#5F7D6E"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,20" />

                <StackPanel x:Name="PainelEmail"
                            Margin="0,0,0,12">
                    <TextBlock Text="E-mail"
                               FontSize="12"
                               Foreground="#4A6658"
                               Margin="0,0,0,6" />

                    <Border Background="White"
                            BorderBrush="#D5E3DC"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,18">
                        <TextBox x:Name="CaixaTextoEmailRecuperacao"
                                 Padding="12"
                                 FontSize="14"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#1F2D26"
                                 MaxLength="80" />
                    </Border>

                    <Button x:Name="BotaoEnviarToken"
                            Content="Enviar token"
                            Style="{StaticResource BotaoPrimarioStyle}"
                            Click="EnviarTokenBotao_Click"
                            Margin="0,0,0,12" />

                    <Button x:Name="BotaoCancelarEmail"
                            Content="Cancelar"
                            Style="{StaticResource BotaoSecundarioStyle}"
                            HorizontalAlignment="Center"
                            Width="160"
                            Click="CancelarBotao_Click" />
                </StackPanel>

                <StackPanel x:Name="PainelToken"
                            Visibility="Collapsed"
                            Margin="0,0,0,6">
                    <TextBlock Text="Token"
                               FontSize="12"
                               Foreground="#4A6658"
                               Margin="0,0,0,6" />

                    <Border Background="White"
                            BorderBrush="#D5E3DC"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,18">
                        <TextBox x:Name="CaixaTextoToken"
                                 Padding="12"
                                 FontSize="18"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#1F2D26"
                                 CharacterCasing="Upper"
                                 TextAlignment="Center"
                                 MaxLength="12" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BotaoCancelarToken"
                                Grid.Column="0"
                                Content="Cancelar"
                                Style="{StaticResource BotaoSecundarioStyle}"
                                Click="CancelarBotao_Click" />

                        <Button x:Name="BotaoValidarToken"
                                Grid.Column="2"
                                Content="Validar token"
                                Style="{StaticResource BotaoPrimarioStyle}"
                                Click="ValidarTokenBotao_Click" />
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="TextoFeedbackRecuperacao"
                           Foreground="#C43D3D"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MinHeight="18"
                           Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</Window>
