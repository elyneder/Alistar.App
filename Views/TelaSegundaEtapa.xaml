<Window x:Class="Alistar.App.TelaSegundaEtapa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Segunda Etapa"
        Height="760"
        Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Estilos locais da segunda etapa: ficha medica, campos e cards do wizard. -->
        <Style x:Key="TituloSecaoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#111111" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="TituloBlocoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DescricaoBlocoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A5F66" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,22" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RotuloCampoStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="LinhaCamposStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="PainelVerticalStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="LinhaCampoStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#111111" />
            <Setter Property="BorderThickness" Value="0,0,0,1.2" />
            <Setter Property="Padding" Value="2,2,2,3" />
        </Style>

        <Style x:Key="CampoTextoStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#111111" />
        </Style>

        <Style x:Key="CampoTextoMultilinhaStyle" TargetType="TextBox" BasedOn="{StaticResource CampoTextoStyle}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <Style x:Key="CampoComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style x:Key="CaixaSecaoStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CartaoEtapaWizardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E1DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="NumeroEtapaWizardStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#123322" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="TituloEtapaWizardStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#123322" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="DescricaoEtapaWizardStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F7168" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <!-- Tela da avaliacao medica: menu lateral, busca por RA e formulario dividido em wizard. -->
    <Grid Background="#F4F7F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#0B1E14"
                CornerRadius="0,24,24,0">
            <Grid Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                    Margin="0,0,0,40"
                    HorizontalAlignment="Center">
                    <Image Source="/Views/Assets/2-semfundo.png"
                        Width="177"
                        Height="133"
                        Stretch="UniformToFill"/>
                    <TextBlock Text="Sistema de Conscritos"
                        FontSize="12"
                        Foreground="#688077"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="BotaoTelaInicial"
                            Content=" 🏠︎ Tela Inicial"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarTelaInicialBotao_Click" />

                    <Button x:Name="BotaoListaConscritos"
                            Content=" 🔍︎ Consultar Lista"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Click="MostrarListaConscritosBotao_Click" />

                    <Border Margin="0,30,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#163626">
                        <StackPanel>
                            <TextBlock Text="Total de Conscritos Cadastrados"
                                       Foreground="#8BA698"
                                       FontSize="12" />
                            <TextBlock x:Name="TextoQuantidadeConscritos"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="CadastrarEntrevistador" Content=" 👤 Cadastrar Entrevistador"
                            Style="{StaticResource BotaoBarraLateralStyle}"
                            Margin="0,0,0,12"
                            Click="AbrirCadastroUsuarioBotao_Click" />

                    <Button Content=" ➜] Sair do Sistema"
                            Style="{StaticResource BotaoPerigoTextoStyle}"
                            Click="SairSistemaBotao_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">
                <Button HorizontalAlignment="Left"
                    Margin="0,0,0,12"
                    Style="{StaticResource BotaoSecundarioStyle}"
                    Click="MostrarTelaInicialBotao_Click">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="14" Height="14" Margin="0,0,6,0">
                            <Line X1="8" Y1="1" X2="1" Y2="7" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="1" Y1="7" X2="8" Y2="13" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="1" Y1="7" X2="13" Y2="7" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                        <TextBlock Text="Voltar ao Painel"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Segunda Etapa"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#123322" />
                <TextBlock Text="Avaliacao medica do conscrito."
                           FontSize="15"
                           Foreground="#688077"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#EEF2EF"
                    CornerRadius="20"
                    BorderBrush="#DFE7E2"
                    BorderThickness="1"
                    Padding="22">
                <ScrollViewer x:Name="ScrollFormularioSegundaEtapa"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PainelFormularioSegundaEtapa"
                                MaxWidth="980"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="TextoTituloFormulario"
                                   Text="Segunda Etapa - Avaliação Médica"
                                   Style="{StaticResource TituloBlocoStyle}" 
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="TextoDescricaoFormulario"
                                   Text="Preencha os exames e observações médicas do conscrito."
                                   Style="{StaticResource DescricaoBlocoStyle}" 
                                   TextAlignment="Center"/>

                        <Border Background="#F8FBF9"
                                BorderBrush="#DDE7E1"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="18"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <UniformGrid Columns="4"
                                             Margin="0,0,0,16">
                                    <Border x:Name="IndicadorEtapaIdentificacao" Style="{StaticResource CartaoEtapaWizardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="01" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                            <TextBlock Text="Identificação" Style="{StaticResource TituloEtapaWizardStyle}" />
                                            <TextBlock Text="Dados do conscrito" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="IndicadorEtapaExames" Style="{StaticResource CartaoEtapaWizardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="02" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                            <TextBlock Text="Exames" Style="{StaticResource TituloEtapaWizardStyle}" />
                                            <TextBlock Text="Blocos médicos separados" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="IndicadorEtapaSaudeMental" Style="{StaticResource CartaoEtapaWizardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="03" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                            <TextBlock Text="Saúde mental" Style="{StaticResource TituloEtapaWizardStyle}" />
                                            <TextBlock Text="Último bloco médico" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="IndicadorEtapaConfirmacao" Style="{StaticResource CartaoEtapaWizardStyle}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="04" Style="{StaticResource NumeroEtapaWizardStyle}" />
                                            <TextBlock Text="Confirmação" Style="{StaticResource TituloEtapaWizardStyle}" />
                                            <TextBlock Text="Ficha completa para revisar" Style="{StaticResource DescricaoEtapaWizardStyle}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock x:Name="TextoEtapaWizard"
                                           Text="Etapa 1 de 8 · Identificação"
                                           Foreground="#123322"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock x:Name="TextoResumoEtapaWizard"
                                           Margin="0,6,0,0"
                                           Text="Preencha os dados do conscrito para iniciar a avaliação médica."
                                           Foreground="#63756E"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SecaoIdentificacao" Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="IDENTIFICAÇÃO DO CONSCRITO"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <StackPanel Style="{StaticResource PainelVerticalStyle}">
                                    <TextBlock Text="Pesquisar por RA:" Style="{StaticResource RotuloCampoStyle}" />
                                    <Border Style="{StaticResource LinhaCampoStyle}">
                                        <TextBox x:Name="CaixaPesquisaRA"
                                                 Style="{StaticResource CampoTextoStyle}"
                                                 TextChanged="CaixaPesquisaRA_TextChanged" />
                                    </Border>
                                    <Border x:Name="PainelResultadosPesquisaRA"
                                            Visibility="Collapsed"
                                            Margin="0,8,0,0"
                                            Background="#F8FBF9"
                                            BorderBrush="#DDE7E1"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="0">
                                        <ListBox x:Name="ListaResultadosPesquisaRA"
                                                 MaxHeight="180"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 SelectionChanged="ListaResultadosPesquisaRA_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="10,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding RA}"
                                                                   FontWeight="Bold"
                                                                   Foreground="#123322" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Nome}"
                                                                   Foreground="#1F2937" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <TextBlock x:Name="TextoResultadoPesquisaRA"
                                               Margin="0,6,0,0"
                                               Foreground="#63756E"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Nome:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoNome"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="CPF:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoCPF"
                                                     MaxLength="14"
                                                     IsReadOnly="True"
                                                     TextChanged="CampoComMascara_TextChanged"
                                                     Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RA:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoRA"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SecaoAvaliacaoFisica" Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="1. AVALIAÇÃO FÍSICA"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Altura:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoAltura" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="Peso:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoPeso" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Problema de postura:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboProblemaPostura" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Não" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Style="{StaticResource PainelVerticalStyle}">
                                    <TextBlock Text="Observação do médico:" Style="{StaticResource RotuloCampoStyle}" />
                                    <Border Style="{StaticResource LinhaCampoStyle}">
                                        <TextBox x:Name="CaixaTextoObservacaoPostura" Style="{StaticResource CampoTextoMultilinhaStyle}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SecaoVisao" Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="2. VISÃO"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <StackPanel Style="{StaticResource PainelVerticalStyle}">
                                    <TextBlock Text="O conscrito precisa de óculos ou tem dificuldade visual:" Style="{StaticResource RotuloCampoStyle}" />
                                    <Border Style="{StaticResource LinhaCampoStyle}">
                                        <ComboBox x:Name="ComboDificuldadeVisual" Style="{StaticResource CampoComboStyle}">
                                            <ComboBoxItem Content="Selecione" />
                                            <ComboBoxItem Content="Sim" />
                                            <ComboBoxItem Content="Não" />
                                        </ComboBox>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SecaoTesteAuditivo" Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="3. TESTE AUDITIVO"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Alteração auditiva:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboTesteAuditivo" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Não" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Observação:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoObservacaoAuditiva" Style="{StaticResource CampoTextoMultilinhaStyle}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SecaoExameGeral" Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="4. EXAME GERAL"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Pressão arterial:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoPressaoArterial" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="Frequência cardíaca:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoFrequenciaCardiaca" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Respiração:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <TextBox x:Name="CaixaTextoRespiracao" Style="{StaticResource CampoTextoStyle}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SecaoHistoricoMedico" Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="5. HISTÓRICO MÉDICO"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Alguém da sua família tem doenças graves:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboDoencasGravesFamilia" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Não" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Já teve problema cardíaco ou respiratório:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboProblemaCardiacoRespiratorio" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Não" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SecaoSaudeMental" Style="{StaticResource CaixaSecaoStyle}">
                            <StackPanel>
                                <TextBlock Text="6. SAÚDE MENTAL"
                                           Style="{StaticResource TituloSecaoStyle}" />

                                <Grid Style="{StaticResource LinhaCamposStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Já teve ansiedade, depressão ou acompanhamento psicológico:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboSaudeMental" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Não" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Tem dificuldade para dormir:" Style="{StaticResource RotuloCampoStyle}" />
                                        <Border Style="{StaticResource LinhaCampoStyle}">
                                            <ComboBox x:Name="ComboDificuldadeDormir" Style="{StaticResource CampoComboStyle}">
                                                <ComboBoxItem Content="Selecione" />
                                                <ComboBoxItem Content="Sim" />
                                                <ComboBoxItem Content="Não" />
                                            </ComboBox>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TextoFeedback"
                                   Margin="0,8,0,16"
                                   Foreground="#C43D3D"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button x:Name="BotaoVoltarEtapaWizard"
                                Width="120"
                                Margin="0,8,0,0"
                                Style="{StaticResource BotaoSecundarioStyle}"
                                Click="VoltarEtapaWizardBotao_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Line X1="8" Y1="1" X2="1" Y2="7" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="1" Y1="7" X2="8" Y2="13" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="1" Y1="7" X2="13" Y2="7" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                    <TextBlock Text="Voltar"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BotaoSalvar"
                                Width="180"
                                Margin="16,8,0,0"
                                Style="{StaticResource BotaoPrimarioStyle}"
                                Click="SalvarBotao_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="IconeAvancarBotaoSalvar"
                                               Text="->"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                                    <Canvas x:Name="IconeSalvarBotaoSalvar" Width="14" Height="14" Margin="0,0,6,0" Visibility="Collapsed">
                                        <Polyline Points="2,7 6,11 12,3"
                                          Stroke="White" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                    <TextBlock x:Name="TextoBotaoSalvar" Text="Próximo"/>
                                </StackPanel>
                            </Button>

                            <Button Width="120"
                                Margin="16,8,0,0"
                                Style="{StaticResource BotaoSecundarioStyle}"
                                Click="LimparBotao_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="14" Height="14" Margin="0,0,6,0">
                                        <Line X1="2" Y1="2" X2="12" Y2="12" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="12" Y1="2" X2="2" Y2="12" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                    <TextBlock Text="Limpar"/>
                                </StackPanel>
                            </Button>

                            <Button Width="120"
                                Margin="16,8,0,0"
                                Style="{StaticResource BotaoSecundarioStyle}"
                                Click="MostrarTelaInicialBotao_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Canvas Width="14" Height="14" Margin="0,0,6,0">
                                        <Line X1="7" Y1="1" X2="7" Y2="13" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="1" Y1="7" X2="7" Y2="13" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Line X1="13" Y1="7" X2="7" Y2="13" Stroke="#196743" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                    <TextBlock Text="Fechar"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
