<Window x:Class="Alistar.App.TelaTerceiraEtapa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alistar | Entrevista Técnica"
        Height="520"
        Width="860"
        WindowStartupLocation="CenterOwner"
        Icon="/Views/Assets/alistar_icone.ico">
    <!-- Estrutura mantida apenas como fallback; o painel abre a entrevista tecnica no wizard da primeira etapa. -->
    <Grid Background="#F4F7F6">
        <Border Margin="24"
                Padding="28"
                Background="White"
                CornerRadius="18"
                BorderBrush="#DFE7E2"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Entrevista Técnica"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#123322" />
                    <TextBlock Text="Revisão e atualização dos dados coletados na primeira etapa."
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#5A5F66" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,28,0,28"
                        Padding="22"
                        Background="#EEF2EF"
                        CornerRadius="14">
                    <TextBlock Text="Abra a terceira etapa pelo painel para revisar a ficha do conscrito no mesmo wizard da primeira etapa."
                               TextWrapping="Wrap"
                               Foreground="#4B5563" />
                </Border>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="120"
                            Style="{StaticResource BotaoSecundarioStyle}"
                            Click="FecharBotao_Click"
                            Content="X Fechar" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
